---
/**
 * Customer quote card: brand-yellow quote mark, quote text (default slot),
 * author name and role. Used on landing pages instead of the old slick
 * carousel slides.
 */
interface Props {
  author: string;
  role: string;
}

const { author, role } = Astro.props;
---

<div class="flex h-full flex-col rounded-[0.3125rem] bg-white p-8 shadow-card">
  <figure class="mb-4" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 8 8">
      <path
        fill="#FABD00"
        d="M3,1.3C2,1.7,1.2,2.7,1.2,3.6c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5 C1.4,6.9,1,6.6,0.7,6.1C0.4,5.6,0.3,4.9,0.3,4.5c0-1.6,0.8-2.9,2.5-3.7L3,1.3z M7.1,1.3c-1,0.4-1.8,1.4-1.8,2.3 c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5c-0.7,0-1.1-0.3-1.4-0.8 C4.4,5.6,4.4,4.9,4.4,4.5c0-1.6,0.8-2.9,2.5-3.7L7.1,1.3z"
      ></path>
    </svg>
  </figure>

  <blockquote class="mb-4 grow leading-relaxed">
    <slot />
  </blockquote>

  <div>
    <p class="text-lg font-bold">{author}</p>
    <p class="text-sm">{role}</p>
  </div>
</div>
