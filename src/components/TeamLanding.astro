---
import GradientHero from './GradientHero.astro';
import LandingIconHighlights from './LandingIconHighlights.astro';
import TestimonialCard from './TestimonialCard.astro';
import TrackedLink from './TrackedLink.astro';
import { btnPrimary } from '../lib/cta';
import type { TeamLandingCopy } from '../data/team-landing';

/**
 * Shared body of the /team-collectivites and /team-entreprises landing pages
 * (ported from templates/landing/team-*.html.twig, which were identical except
 * for the meta title, the tracking context and the hero audience word).
 * Text-free shell: every string comes from the `copy` prop, provided by the
 * market's pages (see src/data/team-landing.fr.ts).
 */
interface Props {
  /** Highlighted audience word in the hero H1 (e.g. "collectivités"). */
  audience: string;
  /** Analytics context, e.g. "page_collectivites" (matches the old Twig pages). */
  trackingContext: string;
  copy: TeamLandingCopy;
}

const { audience, trackingContext, copy } = Astro.props;
---

<!-- Hero Section -->
<GradientHero>
  <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-[2.5rem] font-bold lg:text-[3.5rem]">
          {copy.hero.titlePrefix}<span class="text-primary">{audience}</span>
        </h1>
        <p class="mt-4 text-xl">{copy.hero.catch}</p>

        <div class="mt-8">
          <TrackedLink
            eventId="cta_header"
            trackingContext={trackingContext}
            class={btnPrimary}
          >
            {copy.hero.cta}
          </TrackedLink>
        </div>
      </div>

      <div class="hidden sm:block">
        <img
          class="w-full rounded-xl border border-beige-line shadow-card"
          src="/assets/landing-pages/header-screen-macbook.jpg"
          alt={copy.hero.imageAlt}
          width="1618"
          height="1010"
        />
      </div>
    </div>
</GradientHero>

<!-- Benefits icon row -->
<LandingIconHighlights items={copy.heroBenefits} />

<!-- "izika Team, c'est" Section -->
<section class="bg-soft-primary">
  <div class="mx-auto max-w-3xl px-4 pt-16 pb-8 text-center">
    <h2 class="text-[2.5rem] font-bold" set:html={copy.intro.titleHtml} />
    <p class="mt-6 text-[1.3125rem] font-bold" set:html={copy.intro.collaboratorsHtml} />
    <p class="my-4" aria-hidden="true">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary font-bold text-white"
      >
        +
      </span>
    </p>
    <p class="text-[1.3125rem] font-bold" set:html={copy.intro.managersHtml} />
  </div>
</section>

<!-- Features Section: collaborateurs -->
<section class="bg-soft-neutral">
  <div class="mx-auto max-w-6xl px-4 pt-16 pb-8 lg:pb-32">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="mb-2 text-sm font-bold tracking-wide uppercase">{copy.collaborators.kicker}</p>
        <h2 class="mb-6 text-3xl font-bold">{copy.collaborators.title}</h2>

        <ul class="space-y-3">
          {
            copy.collaborators.points.map((point) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <p>{point}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto">
        {
          copy.collaborators.screens.map((screen) => (
            <img
              class="w-full shrink-0 snap-center rounded-lg border border-beige-line shadow-card"
              src={screen.src}
              alt={screen.alt}
              width="920"
              height="719"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Features Section: gestionnaires -->
<section class="mx-auto max-w-6xl px-4 pt-16 pb-8 lg:py-32">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <div class="order-last flex snap-x snap-mandatory gap-4 overflow-x-auto lg:order-first">
      {
        copy.managers.screens.map((screen) => (
          <img
            class="w-full shrink-0 snap-center rounded-lg border border-beige-line shadow-card"
            src={screen.src}
            alt={screen.alt}
            width="920"
            height="719"
            loading="lazy"
          />
        ))
      }
    </div>

    <div>
      <p class="mb-2 text-sm font-bold tracking-wide uppercase">{copy.managers.kicker}</p>
      <h2 class="mb-6 text-3xl font-bold">{copy.managers.title}</h2>

      <ul class="space-y-3">
        {
          copy.managers.points.map((point) => (
            <li class="flex items-start gap-3">
              <span
                class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white"
                aria-hidden="true"
              >
                ✓
              </span>
              <p>{point}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- Security Section -->
<section class="bg-soft-primary">
  <div class="mx-auto max-w-6xl px-4 py-16 lg:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="mb-2 text-sm font-bold tracking-wide uppercase">{copy.security.kicker}</p>
        <h2 class="mb-6 text-3xl font-bold">{copy.security.title}</h2>

        <ul class="space-y-3">
          {
            copy.security.points.map((point) => (
              <li class="flex items-start gap-3">
                <span
                  class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white"
                  aria-hidden="true"
                >
                  ✓
                </span>
                <p>{point}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="mx-auto w-4/5">
        <img
          class="h-auto w-full"
          src="/assets/img/illustrations/expert-comptable-large.png"
          alt={copy.security.imageAlt}
          width="1203"
          height="1349"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section class="mx-auto max-w-6xl px-4 pt-16 pb-32">
  <div class="grid gap-6 md:grid-cols-2">
    {
      copy.testimonials.map((testimonial) => (
        <TestimonialCard author={testimonial.author} role={testimonial.role}>
          {testimonial.text}
        </TestimonialCard>
      ))
    }
  </div>
</section>
