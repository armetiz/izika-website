---
import type { MarkdownHeading } from 'astro';

/**
 * Replaces the CommonMark [TOC] placeholder (min heading level 2, like the
 * old TableOfContentsExtension config).
 */
interface Props {
  headings: MarkdownHeading[];
  title?: string;
}

const { headings, title = 'Sommaire' } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  items.length > 0 && (
    <nav class="mx-auto mb-8 max-w-[72ch] rounded-lg bg-beige/60 p-6 lg:max-w-[85%]" aria-label={title}>
      <p class="mb-2 font-semibold">{title}</p>
      <ul class="space-y-1 text-sm">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a class="underline hover:text-primary-hover" href={`#${h.slug}`}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
