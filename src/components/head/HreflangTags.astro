---
import { MARKETS, type MarketId } from '../../i18n';

/**
 * <link rel="alternate" hreflang> tags for a pre-filtered list of alternates
 * (the >= 2 markets emission rule is the caller's responsibility — see
 * hreflangAlternates in src/i18n).
 */
interface Props {
  alternates: ReadonlyArray<{ market: MarketId; href: string }>;
}

const { alternates } = Astro.props;
---

{
  alternates.map((a) => (
    <link
      rel="alternate"
      href={new URL(a.href, Astro.site).href}
      hreflang={MARKETS[a.market].hreflang}
    />
  ))
}
