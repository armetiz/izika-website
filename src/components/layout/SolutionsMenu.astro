---
import {
  t,
  localizedPath,
  solutionPath,
  solutionSlug,
  solutionsBaseSlug,
  type MarketId,
  type SolutionKey,
} from '../../i18n';

interface Props {
  market: MarketId;
}

const { market } = Astro.props;
const dict = t(market);

const teamUrl = localizedPath('team', market);
const soloUrl = localizedPath('solo', market);
const entreprisesUrl = localizedPath('teamEntreprises', market);
const collectivitesUrl = localizedPath('teamCollectivites', market);

// Same entries as the old solutions_menu.html.twig mega menu — labels come
// from the language dictionary, hrefs from the solutionSlugs table (an entry
// is masked in markets where its slug is undefined; the [market]/solutions
// route guarantees at build time that the table matches the content).
const menu = dict.solutionsMenu;
const SOLO_ICONS: Record<SolutionKey, string> = {
  agentsImmobilier: '/assets/solutions/menu/solo/agent-immobilier-mandataire.svg',
  agentAssurances: '/assets/solutions/menu/solo/agent-general-assurance.svg',
  professionsLiberales: '/assets/solutions/menu/solo/professions-liberales.svg',
  artisansBtp: '/assets/solutions/menu/solo/artisan-btp.svg',
  consultants: '/assets/solutions/menu/solo/consultant.svg',
};
const soloItems = (
  [
    'agentsImmobilier',
    'agentAssurances',
    'professionsLiberales',
    'artisansBtp',
    'consultants',
  ] as const
)
  .map((key) => ({ key, slug: solutionSlug(key, market) }))
  .filter((item): item is { key: SolutionKey; slug: string } => item.slug !== undefined)
  .map(({ key, slug }) => ({
    href: solutionPath(slug, market),
    icon: SOLO_ICONS[key],
    ...menu.items[key],
  }));

// The mega menu only exists for markets with solutions content — hidden
// entirely otherwise (table/route partiality masks chrome).
const hasSolutions = solutionsBaseSlug(market) !== undefined && soloItems.length > 0;

const teamItems = [
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/reseau-agences.svg',
    ...menu.items.reseauxAgences,
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/bank-insurance.svg',
    ...menu.items.banqueAssurance,
  },
  {
    href: collectivitesUrl,
    icon: '/assets/solutions/menu/team/administration.svg',
    ...menu.items.administrations,
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/btp-services-techniques.svg',
    ...menu.items.btpServices,
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/commerce-distribution-commercial.svg',
    ...menu.items.commerces,
  },
];

// The solo and team columns share the exact same markup — render both from
// this list so the structure lives once.
const groups = [
  { label: menu.soloGroup, items: soloItems, moreHref: soloUrl, moreLabel: menu.soloMore },
  { label: menu.teamGroup, items: teamItems, moreHref: teamUrl, moreLabel: menu.teamMore },
];
---

{hasSolutions && (
<li id="solutions-menu" class="relative border-b border-beige-line md:static md:border-0">
  <details class="group md:[&[open]>summary]:text-primary-hover">
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-1 py-4 font-bold hover:text-primary-hover md:justify-start md:py-0"
    >
      {dict.nav.solutions}
      <svg
        class="h-3 w-3 transition-transform group-open:rotate-180 md:group-open:rotate-0"
        viewBox="0 0 12 12"
        fill="none"
        aria-hidden="true"
      >
        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </summary>
    <div
      class="grid gap-6 pb-5 md:absolute md:left-1/2 md:z-30 md:mt-4 md:w-[min(64rem,90vw)] md:-translate-x-1/2 md:grid-cols-3 md:rounded-lg md:border-t-2 md:border-primary md:bg-white md:p-8 md:pb-8 md:shadow-card"
    >
      {
        groups.map((group) => (
          <div>
            <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-muted md:mb-3 md:text-sm md:text-current">
              {group.label}
            </span>
            <ul class="md:space-y-1">
              {group.items.map((item) => (
                <li>
                  <a
                    class="flex items-center gap-3 rounded-md py-2 font-normal hover:bg-beige/60 md:p-2"
                    href={item.href}
                  >
                    <img class="h-7 w-7 md:h-9 md:w-9" src={item.icon} alt="" loading="lazy" />
                    <span>
                      <span class="block md:font-semibold">{item.title}</span>
                      <span class="hidden text-sm text-muted md:block">{item.text}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              class="mt-1 inline-block py-2 text-sm font-semibold text-primary hover:underline md:mt-2 md:p-2"
              href={group.moreHref}
            >
              {group.moreLabel}
            </a>
          </div>
        ))
      }
      <div class="hidden md:block">
        <img
          class="mb-3 rounded-lg"
          src="/assets/landing-pages/icon_report-conformity.png"
          alt={menu.blurbImageAlt}
          loading="lazy"
        />
        <p class="text-sm text-muted">{menu.blurb}</p>
      </div>
    </div>
  </details>
</li>
)}

<script>
  // Desktop only: open the mega menu on hover, keep it open while the pointer
  // stays inside (summary or panel), close shortly after it leaves.
  const menu = document.getElementById('solutions-menu');
  const details = menu?.querySelector('details');
  const summary = details?.querySelector('summary');
  const hoverMode = window.matchMedia('(min-width: 768px) and (hover: hover)');
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  menu?.addEventListener('mouseenter', () => {
    if (!hoverMode.matches || !details) return;
    clearTimeout(closeTimer);
    details.open = true;
  });

  menu?.addEventListener('mouseleave', () => {
    if (!hoverMode.matches || !details) return;
    closeTimer = setTimeout(() => {
      details.open = false;
    }, 200);
  });

  // In hover mode a mouse click on the summary would toggle the menu closed
  // while still hovering; keyboard activation (event.detail === 0) keeps working.
  summary?.addEventListener('click', (event) => {
    if (hoverMode.matches && event.detail > 0) event.preventDefault();
  });
</script>
