---
import { t, getMarket, localizedPath, type MarketId } from '../../i18n';
import { btnPrimarySm } from '../../lib/cta';
import SolutionsMenu from './SolutionsMenu.astro';
import TrackedLink from '../ui/TrackedLink.astro';

interface Props {
  market: MarketId;
}

const { market } = Astro.props;
const dict = t(market);
const marketData = getMarket(market);

// Route partiality masks chrome links: a market without the route simply
// doesn't render the entry.
const featuresUrl = localizedPath('features', market);
const pricingUrl = localizedPath('pricing', market);
---

<header class="sticky top-0 z-40 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={localizedPath('home', market)} aria-label="izika" class="shrink-0">
      <img src="/assets/img/logo/izika-logo.png" alt={dict.a11y.logoAlt} width="159" height="56" class="h-10 w-auto" />
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="rounded-md border border-beige-line p-2 md:hidden"
      aria-label={dict.nav.menuOpen}
      data-label-open={dict.nav.menuOpen}
      data-label-close={dict.nav.menuClose}
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <svg
        id="nav-icon-open"
        width="18"
        height="18"
        viewBox="0 0 18 18"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M17.4,6.2H0.6C0.3,6.2,0,5.9,0,5.5V4.1c0-0.4,0.3-0.7,0.6-0.7h16.9c0.3,0,0.6,0.3,0.6,0.7v1.4C18,5.9,17.7,6.2,17.4,6.2z M17.4,14.1H0.6c-0.3,0-0.6-0.3-0.6-0.7V12c0-0.4,0.3-0.7,0.6-0.7h16.9c0.3,0,0.6,0.3,0.6,0.7v1.4C18,13.7,17.7,14.1,17.4,14.1z"
        ></path>
      </svg>
      <svg
        id="nav-icon-close"
        class="hidden"
        width="18"
        height="18"
        viewBox="0 0 18 18"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          d="M3.5 3.5l11 11m0-11l-11 11"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <nav
      id="main-nav"
      class="absolute inset-x-0 top-full hidden h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain border-t border-beige-line bg-white md:static md:block md:h-auto md:overflow-visible md:border-t-0 md:bg-transparent"
    >
      <ul
        class="mx-auto flex max-w-6xl flex-col px-4 pb-10 pt-2 font-bold md:flex-row md:items-center md:gap-6 md:p-0"
      >
        {
          featuresUrl && (
            <li class="border-b border-beige-line md:border-0">
              <a class="block py-4 hover:text-primary-hover md:py-0" href={featuresUrl}>
                {dict.nav.features}
              </a>
            </li>
          )
        }
        <SolutionsMenu market={market} />
        {
          pricingUrl && (
            <li class="border-b border-beige-line md:border-0">
              <a class="block py-4 hover:text-primary-hover md:py-0" href={pricingUrl}>
                {dict.nav.pricing}
              </a>
            </li>
          )
        }
        <li class="mt-6 md:mt-0">
          <a
            class="btn-3d block rounded-card border border-primary px-[1.125rem] py-2.5 text-center text-sm text-primary md:inline-block"
            href={marketData.appUrl}
          >
            {dict.nav.login}
          </a>
        </li>
        <li class="mt-3 md:mt-0">
          <TrackedLink eventId="cta_menu" class={`${btnPrimarySm} w-full text-center md:w-auto`}>
            {dict.cta.try}
          </TrackedLink>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Slide the mobile panel in when it appears; desktop keeps it inert. */
  @media (max-width: 47.99rem) {
    #main-nav:not(.hidden) {
      animation: nav-in 0.18s ease-out;
    }
    @keyframes nav-in {
      from {
        opacity: 0;
        transform: translateY(-0.5rem);
      }
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');
  const desktop = window.matchMedia('(min-width: 768px)');

  function setOpen(open: boolean) {
    nav?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    // Labels come from the language dictionary via data attributes.
    const label = open ? toggle?.dataset.labelClose : toggle?.dataset.labelOpen;
    if (label) toggle?.setAttribute('aria-label', label);
    // Lock page scroll behind the full-screen panel (mobile only — the
    // toggle itself is hidden on desktop).
    document.documentElement.classList.toggle('overflow-hidden', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(nav?.classList.contains('hidden') === true);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('hidden') === false && !desktop.matches) {
      setOpen(false);
    }
  });

  // Leaving mobile with the panel open would keep the scroll lock in place.
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
