---
import { t, getMarket, localizedPath, type MarketId, type RouteKey } from '../i18n';
import CountrySwitcher from './CountrySwitcher.astro';
import TrustpilotBadge from './TrustpilotBadge.astro';

interface Props {
  market: MarketId;
  /** Forwarded to CountrySwitcher for page-to-page equivalence. */
  routeKey?: RouteKey;
  /**
   * Footer-zone background: 'beige' (default site-wide), 'gradient' (the
   * solo/team landing gradient), 'soft' (the collectivités/entreprises
   * landing tint). Pair with the same background on LandingClosingCta so the
   * CTA and the footer read as one zone.
   */
  background?: 'beige' | 'gradient' | 'soft';
}

const { market, routeKey, background = 'beige' } = Astro.props;
const dict = t(market);
const marketData = getMarket(market);
const year = new Date().getFullYear();

const backgroundClass = {
  beige: 'bg-beige',
  gradient: 'footer-gradient',
  soft: 'bg-soft-neutral',
}[background];

// Route partiality masks chrome links: a market without the route simply
// doesn't render the entry.
const navLinks = [
  { href: localizedPath('features', market), label: dict.nav.features },
  { href: localizedPath('calculator', market), label: dict.footer.calculator },
  { href: localizedPath('articles', market), label: dict.nav.articles },
  { href: localizedPath('faq', market), label: dict.nav.faq },
  { href: localizedPath('team', market), label: dict.footer.team },
  { href: localizedPath('security', market), label: dict.footer.security },
].filter((l): l is { href: string; label: string } => l.href !== null);

const legalLinks = [
  { href: localizedPath('legal', market), label: dict.footer.legal },
  { href: localizedPath('privacy', market), label: dict.footer.privacy },
  { href: localizedPath('terms', market), label: dict.footer.terms },
].filter((l): l is { href: string; label: string } => l.href !== null);

// The consent widget can only be reopened when Axeptio is actually loaded —
// same env switch as Analytics.astro, so dev/preview never show a dead button.
const consentEnabled = Boolean(import.meta.env.PUBLIC_AXEPTIO_CLIENT_ID);

// Tap-target sized (≥40px) hit area, underline reserved for hover so the row
// doesn't read as a wall of links.
const legalLink =
  'block rounded-card px-1 py-2.5 text-muted underline-offset-4 transition-colors hover:text-ink hover:underline focus-visible:text-ink';

// The trustpilot column only exists on markets that have reviews; without it
// the nav must not float in the middle of an empty grid.
const gridClass = marketData.trustpilot
  ? 'lg:grid-cols-[2fr_1.5fr_1fr]'
  : 'lg:grid-cols-[2fr_1.5fr]';
---

<footer class={backgroundClass}>
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <div class={`grid gap-x-10 gap-y-8 lg:gap-10 ${gridClass}`}>
      <div>
        <a class="mb-4 inline-flex items-center" href={localizedPath('home', market)} aria-label="izika">
          <img src="/assets/img/logo/izika-logo.png" alt={dict.a11y.logoAlt} width="159" height="56" class="h-12 w-auto" />
        </a>

        <div>
          <p class="text-lg font-semibold">{dict.footer.mission}</p>
          <p>
            <em>{dict.footer.quote}</em>
          </p>
        </div>
      </div>

      {/* Mobile: a divided, thumb-sized list — same affordance as the header's
          mobile panel, so the links stop reading as plain text. Desktop keeps
          the plain footer column. */}
      <div class="lg:pt-8">
        <ul class="border-t border-beige-line lg:space-y-2 lg:border-0">
          {
            navLinks.map((link) => (
              <li class="border-b border-beige-line lg:border-0">
                <a
                  class="flex items-center justify-between gap-4 py-3.5 hover:underline lg:block lg:py-0"
                  href={link.href}
                >
                  {link.label}
                  <span aria-hidden="true" class="text-muted lg:hidden">
                    ›
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        marketData.trustpilot && (
          <div class="lg:pt-8">
            <TrustpilotBadge market={market} variant="stars" />
          </div>
        )
      }
    </div>

    <div class="mt-8 border-t border-beige-line pt-4 pb-8 text-sm lg:mt-12">
      <div class="flex flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between">
        <nav aria-label={dict.a11y.legalNav} class="lg:order-1">
          <ul class="-ml-1 flex flex-wrap items-center gap-x-5">
            {
              legalLinks.map((link) => (
                <li>
                  <a class={legalLink} href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
            {
              consentEnabled && (
                <li>
                  {/* A button, not a fake javascript: link — it opens a widget,
                      it doesn't navigate. */}
                  <button type="button" id="footer-consent" class={legalLink}>
                    {dict.footer.cookies}
                  </button>
                </li>
              )
            }
          </ul>
        </nav>

        <CountrySwitcher market={market} routeKey={routeKey} class="lg:order-2" />
      </div>

      {/* Ancienneté puis identité légale: le fait d'entreprise se lit avec le
          RCS, pas comme une signature en haut de colonne. */}
      <p class="mt-4 text-xs text-muted">{dict.footer.since}</p>
      <p class="mt-1 text-xs text-muted">
        ©Copyright {year} {marketData.legal.entity} - {marketData.legal.footerLines.join(' - ')}
      </p>
    </div>
  </div>
</footer>

{
  consentEnabled && (
    <script>
      // Axeptio drains `_axcb` once its SDK is ready, so queuing works even if
      // the visitor clicks before the CMP has loaded.
      document.getElementById('footer-consent')?.addEventListener('click', () => {
        const w = window as unknown as {
          _axcb?: Array<(sdk: { requestConsent: () => void }) => void>;
        };
        w._axcb = w._axcb || [];
        w._axcb.push((sdk) => sdk.requestConsent());
      });
    </script>
  )
}
