---
import Card from './Card.astro';
import QuoteIcon from './QuoteIcon.astro';

/**
 * Customer quote card: brand-yellow quote mark, quote text (default slot),
 * author name and role. Used on landing pages instead of the old slick
 * carousel slides. Quote text is gray like any `.card-body`.
 */
interface Props {
  author: string;
  role: string;
}

const { author, role } = Astro.props;
---

<Card bodyClass="flex flex-col p-8">
  <figure class="mb-4" aria-hidden="true">
    <QuoteIcon size={40} fillClass="fill-primary" />
  </figure>

  <blockquote class="mb-4 grow leading-relaxed">
    <slot />
  </blockquote>

  <div>
    <p class="text-lg font-bold text-ink">{author}</p>
    <p class="text-sm">{role}</p>
  </div>
</Card>
