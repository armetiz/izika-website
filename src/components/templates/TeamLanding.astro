---
import GradientHero from '../ui/GradientHero.astro';
import LandingChecklistSection from '../sections/LandingChecklistSection.astro';
import LandingClosingCta from '../sections/LandingClosingCta.astro';
import LandingIconHighlights from '../sections/LandingIconHighlights.astro';
import LandingScreenshot from '../sections/LandingScreenshot.astro';
import TestimonialCard from '../ui/TestimonialCard.astro';
import TrackedLink from '../ui/TrackedLink.astro';
import { btnPrimary } from '../../lib/cta';
import type { TeamLandingCopy } from '../../data/team-landing';

/**
 * Shared body of the /team-collectivites and /team-entreprises landing pages
 * (ported from templates/landing/team-*.html.twig, which were identical except
 * for the meta title, the tracking context and the hero audience word).
 * Text-free shell: every string comes from the `copy` prop, provided by the
 * market's pages (see src/data/team-landing.fr.ts).
 */
interface Props {
  /** Highlighted audience word in the hero H1 (e.g. "collectivités"). */
  audience: string;
  /** Analytics context, e.g. "page_collectivites" (matches the old Twig pages). */
  trackingContext: string;
  copy: TeamLandingCopy;
}

const { audience, trackingContext, copy } = Astro.props;

---

<!-- Hero Section -->
<GradientHero>
  <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-[2.5rem] font-bold lg:text-[3.5rem]">
          {copy.hero.titlePrefix}<span class="text-primary">{audience}</span>
        </h1>
        <p class="mt-4 text-xl">{copy.hero.catch}</p>

        <div class="mt-8">
          <TrackedLink
            eventId="cta_header"
            trackingContext={trackingContext}
            class={btnPrimary}
          >
            {copy.hero.cta}
          </TrackedLink>
        </div>
      </div>

      <div class="hidden sm:block">
        <img
          class="w-full rounded-xl border border-beige-line shadow-card"
          src={copy.hero.image}
          alt={copy.hero.imageAlt}
          width={copy.hero.imageWidth}
          height={copy.hero.imageHeight}
        />
      </div>
    </div>
</GradientHero>

<!-- Benefits icon row -->
<LandingIconHighlights items={copy.heroBenefits} />

<!-- "izika Team, c'est" Section -->
<section class="bg-soft-primary">
  <div class="mx-auto max-w-3xl px-4 pt-16 pb-8 text-center">
    <h2 class="text-[2.5rem] font-bold" set:html={copy.intro.titleHtml} />
    <p class="mt-6 text-[1.3125rem] font-bold" set:html={copy.intro.collaboratorsHtml} />
    <p class="my-4" aria-hidden="true">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary font-bold text-white"
      >
        +
      </span>
    </p>
    <p class="text-[1.3125rem] font-bold" set:html={copy.intro.managersHtml} />
  </div>
</section>

<!-- Features Section: collaborateurs -->
<LandingChecklistSection
  class="bg-soft-neutral"
  eyebrow={copy.collaborators.kicker}
  title={copy.collaborators.title}
  items={copy.collaborators.points}
>
  <LandingScreenshot {...copy.collaborators.screen} />
</LandingChecklistSection>

<!-- Features Section: gestionnaires -->
<LandingChecklistSection
  reverse
  eyebrow={copy.managers.kicker}
  title={copy.managers.title}
  items={copy.managers.points}
>
  <LandingScreenshot {...copy.managers.screen} />
</LandingChecklistSection>

<!-- Security Section -->
<LandingChecklistSection
  class="bg-soft-primary"
  eyebrow={copy.security.kicker}
  title={copy.security.title}
  items={copy.security.points}
>
  <figure class="mx-auto w-4/5">
    <img
      class="h-auto w-full"
      src="/assets/illustrations/sketch-accountant.png"
      alt={copy.security.imageAlt}
      width="1203"
      height="1349"
      loading="lazy"
    />
  </figure>
</LandingChecklistSection>

<!-- Testimonials Section -->
<section class="mx-auto max-w-6xl px-4 pt-16 pb-32">
  <div class="grid gap-6 md:grid-cols-2">
    {
      copy.testimonials.map((testimonial) => (
        <TestimonialCard author={testimonial.author} role={testimonial.role}>
          {testimonial.text}
        </TestimonialCard>
      ))
    }
  </div>
</section>

<!-- Closing CTA : la même section « essai gratuit » que /solo et /team, portée
     par le template et non par chaque route, pour que les quatre landings
     d'audience se terminent à l'identique. `bg-soft-neutral` doit rester
     accordé au footerBackground="soft" des pages. -->
<LandingClosingCta
  title={copy.closing.title}
  text={copy.closing.text}
  ctaLabel={copy.closing.ctaLabel}
  trackingContext={trackingContext}
  class="bg-soft-neutral"
>
  {copy.closing.noteHtml && <p class="mt-4" set:html={copy.closing.noteHtml} />}
</LandingClosingCta>
