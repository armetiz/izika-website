---
import { tableClass, thClass, tdClass } from '../lib/ui';

/**
 * One pre-rendered barème table of the calculator page (cars / motorcycles):
 * power classes as rows, distance-bracket formulas as cells. Pure data in —
 * the host page precomputes labels and formulas from src/data/bareme-ik.ts.
 */
interface Props {
  title: string;
  /** Top-left column header (e.g. "Puissance fiscale"). */
  cornerLabel: string;
  headers: ReadonlyArray<string>;
  rows: ReadonlyArray<{ label: string; cells: ReadonlyArray<string> }>;
}

const { title, cornerLabel, headers, rows } = Astro.props;
---

<div>
  <h3 class="text-[1.3125rem] font-bold">{title}</h3>
  <div class="mt-4 overflow-x-auto rounded-card bg-white shadow-card">
    <table class={tableClass}>
      <thead>
        <tr>
          <th class={thClass} scope="col">{cornerLabel}</th>
          {headers.map((header) => (
            <th class={thClass} scope="col">{header}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <th class={thClass} scope="row">{row.label}</th>
            {row.cells.map((cell) => (
              <td class={tdClass}>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
