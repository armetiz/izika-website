---
import GradientHero from '../ui/GradientHero.astro';
import TrackedLink from '../ui/TrackedLink.astro';
import { btnPrimary } from '../../lib/cta';

/**
 * Landing/home hero: headline on the left (either a static `title`, or a
 * `titlePrefix` followed by a highlighted rotating word — the old Typed.js
 * animation, first word server-rendered so the page works without JS), a
 * lead (`lead` prop or slot "lead"), a primary tracked CTA plus optional
 * extra actions (slot "secondary"), and a visual (slot "media").
 */
interface Props {
  /** Static headline (home pages). Exclusive with titlePrefix/words. */
  title?: string;
  titlePrefix?: string;
  /** Rotating highlighted words; the first one is the no-JS fallback. */
  words?: readonly string[];
  /** Plain-text lead; use slot "lead" for rich content instead. */
  lead?: string;
  ctaEventId: string;
  ctaLabel: string;
  /** Tracking context override (defaults to page_<segment> in TrackedLink). */
  trackingContext?: string;
  /** GradientHero pass-throughs (the home page uses beige/tall). */
  tone?: 'primary' | 'beige';
  size?: 'default' | 'tall' | 'short';
}

const { title, titlePrefix, words, ctaEventId, ctaLabel, trackingContext, lead, tone, size } =
  Astro.props;
---

<GradientHero tone={tone} size={size}>
  <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        {
          title !== undefined ? (
            <h1 class="text-4xl leading-[1.2] font-bold lg:text-[3.5rem]">{title}</h1>
          ) : (
            <h1 class="text-4xl leading-[1.2] font-bold lg:text-[3.5rem]">
              {titlePrefix}&nbsp;<span
                class="text-primary"
                data-rotating-words={JSON.stringify(words)}
              >{words?.[0]}</span>
            </h1>
          )
        }
        {
          lead !== undefined ? (
            <p class="mt-4 text-lg">{lead}</p>
          ) : (
            <div class="mt-4 text-lg">
              <slot name="lead" />
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <TrackedLink
            eventId={ctaEventId}
            trackingContext={trackingContext}
            class={btnPrimary}
          >
            {ctaLabel}
          </TrackedLink>
          <slot name="secondary" />
        </div>
      </div>

      <div>
        <slot name="media" />
      </div>
    </div>
</GradientHero>

<script>
  // Vanilla replacement for the old Typed.js hero animation
  // (typeSpeed 60, backSpeed 25, backDelay 1500, loop).
  for (const el of document.querySelectorAll<HTMLElement>('[data-rotating-words]')) {
    const words = JSON.parse(el.dataset.rotatingWords ?? '[]') as string[];
    if (words.length < 2) continue;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) continue;

    let index = 0;
    let text = words[0] ?? '';
    let deleting = false;

    const tick = () => {
      const word = words[index % words.length] ?? '';
      text = deleting ? word.slice(0, text.length - 1) : word.slice(0, text.length + 1);
      el.textContent = text;

      let delay = deleting ? 25 : 60;
      if (!deleting && text === word) {
        deleting = true;
        delay = 1500;
      } else if (deleting && text === '') {
        deleting = false;
        index += 1;
        delay = 200;
      }
      window.setTimeout(tick, delay);
    };

    window.setTimeout(tick, 1500);
  }
</script>
