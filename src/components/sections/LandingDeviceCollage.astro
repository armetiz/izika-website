---
/**
 * Hero screenshot collage for the solo/team landings (successor of the old
 * device-frame mockups): a large desktop screen with three overlays. Hidden
 * below lg like the Twig original.
 *
 * All four images come from the page copy: they show the app in a language,
 * a currency and a distance unit, so they are market assets and none of them
 * can be hardcoded here.
 */
interface Props {
  desktopSrc: string;
  desktopAlt: string;
  desktopWidth: number;
  desktopHeight: number;
  tabletSrc: string;
  tabletAlt: string;
  tabletWidth: number;
  tabletHeight: number;
  ipadSrc: string;
  ipadAlt: string;
  ipadWidth: number;
  ipadHeight: number;
  mobileSrc: string;
  mobileAlt: string;
  mobileWidth: number;
  mobileHeight: number;
}

const {
  desktopSrc,
  desktopAlt,
  desktopWidth,
  desktopHeight,
  tabletSrc,
  tabletAlt,
  tabletWidth,
  tabletHeight,
  ipadSrc,
  ipadAlt,
  ipadWidth,
  ipadHeight,
  mobileSrc,
  mobileAlt,
  mobileWidth,
  mobileHeight,
} = Astro.props;
---

<div class="relative hidden lg:block">
  <img
    class="w-full rounded-xl border border-beige-line shadow-card"
    src={desktopSrc}
    alt={desktopAlt}
    width={desktopWidth}
    height={desktopHeight}
  />
  <img
    class="absolute -top-10 -left-6 w-52 -rotate-3 rounded-card border-4 border-white shadow-card"
    src={tabletSrc}
    alt={tabletAlt}
    width={tabletWidth}
    height={tabletHeight}
  />
  <img
    class="absolute -bottom-10 -left-2 w-32 rotate-2 rounded-card border-4 border-white shadow-card"
    src={ipadSrc}
    alt={ipadAlt}
    width={ipadWidth}
    height={ipadHeight}
  />
  <img
    class="absolute -right-4 -bottom-8 w-24 rounded-2xl border-4 border-white shadow-card"
    src={mobileSrc}
    alt={mobileAlt}
    width={mobileWidth}
    height={mobileHeight}
  />
</div>
