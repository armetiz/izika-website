---
import GradientHero from './GradientHero.astro';
import { t, type MarketId } from '../i18n';

/**
 * Shared shell for the legal-style pages (mentions légales, charte de
 * confidentialité, CGV, politique de sécurité): gradient hero title band
 * closed by the white wave, then a two-column layout with a sticky in-page
 * nav card and the document body.
 */
interface Props {
  market: MarketId;
  title: string;
  /** Optional heading shown above the nav list (CGV shows "Les articles"). */
  navTitle?: string;
  toc: ReadonlyArray<{ href: string; label: string }>;
}

const { market, title, navTitle, toc } = Astro.props;
const dict = t(market);
---

<GradientHero class="text-center">
  <h1 class="text-[2.5rem] font-bold">{title}</h1>
</GradientHero>

<section class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-16 md:grid-cols-[16rem_minmax(0,1fr)] lg:grid-cols-[18rem_minmax(0,1fr)] lg:pb-32">
  <nav class="self-start rounded-card bg-beige-light p-6 md:sticky md:top-24" aria-label={dict.article.tocTitle}>
    {navTitle && <p class="mb-3 text-lg font-bold">{navTitle}</p>}
    <ul class="space-y-2 text-sm font-bold">
      {toc.map((item) => (
        <li>
          <a class="block hover:text-primary-hover" href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="min-w-0">
    <div class="prose prose-izika max-w-none [&_h2]:text-[1.3125rem]!">
      <slot />
    </div>
  </div>
</section>
