---
/**
 * Shared shell for the legal-style pages (mentions légales, charte de
 * confidentialité, CGV, politique de sécurité): beige hero title band, then a
 * two-column layout with a sticky in-page nav card and the document body.
 */
interface Props {
  title: string;
  /** Optional heading shown above the nav list (CGV shows "Les articles"). */
  navTitle?: string;
  toc: ReadonlyArray<{ href: string; label: string }>;
}

const { title, navTitle, toc } = Astro.props;
---

<section class="bg-beige-light pt-12 pb-16 md:pt-16">
  <div class="mx-auto max-w-6xl px-4 text-center">
    <h1 class="text-[2.5rem] font-bold">{title}</h1>
  </div>
</section>

<section class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-16 md:grid-cols-[16rem_minmax(0,1fr)] lg:grid-cols-[18rem_minmax(0,1fr)] lg:pb-32">
  <nav class="self-start rounded-[0.3125rem] bg-beige-light p-6 md:sticky md:top-24" aria-label="Sommaire">
    {navTitle && <h4 class="mb-3 text-lg font-bold">{navTitle}</h4>}
    <ul class="space-y-2 text-sm font-bold">
      {toc.map((item) => (
        <li>
          <a class="block hover:text-primary-hover" href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="min-w-0">
    <slot />
  </div>
</section>
