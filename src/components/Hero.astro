---
import GradientHero from './GradientHero.astro';
import TrackedLink from './TrackedLink.astro';
import { btnPrimary } from '../lib/cta';

/**
 * Home-page hero: headline + lead + primary tracked CTA on the left,
 * optional extra actions (slot "secondary") and visual (slot "media") on the
 * right. The solo/team landings use LandingHero (rotating word variant).
 */
interface Props {
  title: string;
  lead: string;
  ctaEventId: string;
  ctaLabel: string;
  /** Tracking context override (defaults to page_<segment> in TrackedLink). */
  trackingContext?: string;
}

const { title, lead, ctaEventId, ctaLabel, trackingContext } = Astro.props;
---

<GradientHero tone="beige" size="tall">
  <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h1 class="text-4xl leading-[1.2] font-bold lg:text-[3.5rem]">{title}</h1>
        <p class="mt-4 text-lg">{lead}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <TrackedLink
            eventId={ctaEventId}
            trackingContext={trackingContext}
            class={btnPrimary}
          >
            {ctaLabel}
          </TrackedLink>
          <slot name="secondary" />
        </div>
      </div>

      <div>
        <slot name="media" />
      </div>
    </div>
</GradientHero>
