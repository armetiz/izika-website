---
import { t, getMarket, type MarketId } from '../i18n';
import { reviews } from '../data/reviews';

/**
 * The Trustpilot rating badge, unified (it used to be re-implemented with a
 * different markup at every call site). Renders nothing for markets without
 * a Trustpilot presence.
 * - "stars": rating + 4½ stars + "see all reviews" link (footer).
 * - "compact": big rating + one star, accessible label (heroes, sections).
 */
interface Props {
  market: MarketId;
  variant?: 'stars' | 'compact';
  /** Extra classes on the root element (e.g. margins). */
  class?: string;
}

const { market, variant = 'compact', class: className } = Astro.props;
const dict = t(market);
const trustpilot = getMarket(market).trustpilot;
const ratingAria = dict.a11y.ratingAria
  .replace('{rating}', reviews.ratingValue)
  .replace('{max}', reviews.bestRating);
---

{
  trustpilot && variant === 'stars' && (
    <div class:list={['flex items-center gap-3', className]}>
      <a class="text-[2.5rem] font-bold" href={trustpilot.url} rel="nofollow">
        {reviews.ratingValue}
      </a>
      <div class="flex flex-col">
        <a
          class="flex items-center gap-0.5 text-primary"
          rel="nofollow"
          href={trustpilot.url}
          aria-label={ratingAria}
        >
          {/* 4 full stars + 1 half star, like the fa-star/fa-star-half icons */}
          {[0, 1, 2, 3].map(() => (
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          ))}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2v15.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
          </svg>
        </a>
        <a href={trustpilot.url} class="underline" rel="nofollow">
          {dict.footer.seeAllReviews}
        </a>
      </div>
    </div>
  )
}
{
  trustpilot && variant === 'compact' && (
    <a
      class:list={['inline-flex items-center justify-center gap-2 text-[2.5rem] font-bold', className]}
      href={trustpilot.url}
      rel="nofollow"
      aria-label={ratingAria}
    >
      {reviews.ratingValue}
      <span class="text-primary" aria-hidden="true">★</span>
    </a>
  )
}
