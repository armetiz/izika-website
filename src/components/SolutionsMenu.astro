---
import { t, localizedPath, solutionPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const teamUrl = localizedPath('team', locale);
const soloUrl = localizedPath('solo', locale);
const entreprisesUrl = localizedPath('teamEntreprises', locale);
const collectivitesUrl = localizedPath('teamCollectivites', locale);

// Same entries as the old solutions_menu.html.twig mega menu.
const soloItems = [
  {
    href: solutionPath('agents-immobilier-mandataires-immobilier', locale),
    icon: '/assets/solutions/menu/solo/agent-immobilier-mandataire.svg',
    title: 'Agent Immobilier',
    text: 'Agents & mandataires',
  },
  {
    href: solutionPath('agent-general-assurances', locale),
    icon: '/assets/solutions/menu/solo/agent-general-assurance.svg',
    title: "Agent Général d'assurances",
    text: 'Déplacements clients et IK sans saisie',
  },
  {
    href: solutionPath('professions-liberales', locale),
    icon: '/assets/solutions/menu/solo/professions-liberales.svg',
    title: 'Professions libérales',
    text: 'Médecins, kinés, infirmiers, avocats…',
  },
  {
    href: solutionPath('artisans-btp', locale),
    icon: '/assets/solutions/menu/solo/artisan-btp.svg',
    title: 'Artisans & BTP',
    text: 'Déplacements chantiers',
  },
  {
    href: solutionPath('consultants', locale),
    icon: '/assets/solutions/menu/solo/consultant.svg',
    title: 'Consultants',
    text: 'Vos trajets clients sans effort',
  },
];

const teamItems = [
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/reseau-agences.svg',
    title: 'Réseaux d’agences',
    text: 'Suivi homogène des IK',
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/bank-insurance.svg',
    title: 'Banque & Assurance',
    text: "Gestion d'IK pour vos conseillers terrain",
  },
  {
    href: collectivitesUrl,
    icon: '/assets/solutions/menu/team/administration.svg',
    title: 'Administrations',
    text: 'IK pour collectivités, associations, ...',
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/btp-services-techniques.svg',
    title: 'BTP / Services techniques',
    text: 'Gérez les trajets de vos équipes mobiles',
  },
  {
    href: entreprisesUrl,
    icon: '/assets/solutions/menu/team/commerce-distribution-commercial.svg',
    title: 'Commerces & Distribution',
    text: 'Déplacements de vos équipes, simplifiés',
  },
];
---

<li id="solutions-menu" class="relative border-b border-beige-line md:static md:border-0">
  <details class="group md:[&[open]>summary]:text-primary-hover">
    <summary
      class="flex cursor-pointer list-none items-center justify-between gap-1 py-4 font-bold hover:text-primary-hover md:justify-start md:py-0"
    >
      {dict.nav.solutions}
      <svg
        class="h-3 w-3 transition-transform group-open:rotate-180 md:group-open:rotate-0"
        viewBox="0 0 12 12"
        fill="none"
        aria-hidden="true"
      >
        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </summary>
    <div
      class="grid gap-6 pb-5 md:absolute md:left-1/2 md:z-30 md:mt-4 md:w-[min(64rem,90vw)] md:-translate-x-1/2 md:grid-cols-3 md:rounded-lg md:border-t-2 md:border-primary md:bg-white md:p-8 md:pb-8 md:shadow-card"
    >
      <div>
        <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-muted md:mb-3 md:text-sm md:text-current">
          Solos et Indépendants
        </span>
        <ul class="md:space-y-1">
          {
            soloItems.map((item) => (
              <li>
                <a
                  class="flex items-center gap-3 rounded-md py-2 font-normal hover:bg-beige/60 md:p-2"
                  href={item.href}
                >
                  <img class="h-7 w-7 md:h-9 md:w-9" src={item.icon} alt="" loading="lazy" />
                  <span>
                    <span class="block md:font-semibold">{item.title}</span>
                    <span class="hidden text-sm text-muted md:block">{item.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          class="mt-1 inline-block py-2 text-sm font-semibold text-primary hover:underline md:mt-2 md:p-2"
          href={soloUrl}
        >
          Découvrir izika pour les indépendants →
        </a>
      </div>
      <div>
        <span class="mb-1 block text-xs font-bold uppercase tracking-wide text-muted md:mb-3 md:text-sm md:text-current">
          PME et Équipes
        </span>
        <ul class="md:space-y-1">
          {
            teamItems.map((item) => (
              <li>
                <a
                  class="flex items-center gap-3 rounded-md py-2 font-normal hover:bg-beige/60 md:p-2"
                  href={item.href}
                >
                  <img class="h-7 w-7 md:h-9 md:w-9" src={item.icon} alt="" loading="lazy" />
                  <span>
                    <span class="block md:font-semibold">{item.title}</span>
                    <span class="hidden text-sm text-muted md:block">{item.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a
          class="mt-1 inline-block py-2 text-sm font-semibold text-primary hover:underline md:mt-2 md:p-2"
          href={teamUrl}
        >
          Découvrir izika pour les équipes →
        </a>
      </div>
      <div class="hidden md:block">
        <img
          class="mb-3 rounded-lg"
          src="/assets/landing-pages/icon_report-conformity.png"
          alt="Conforme aux règles fiscales"
          loading="lazy"
        />
        <p class="text-sm text-muted">
          izika est la solution de déclaration d'IK recommandée par les experts comptables pour les
          entrepreneurs et les PME.
        </p>
      </div>
    </div>
  </details>
</li>

<script>
  // Desktop only: open the mega menu on hover, keep it open while the pointer
  // stays inside (summary or panel), close shortly after it leaves.
  const menu = document.getElementById('solutions-menu');
  const details = menu?.querySelector('details');
  const summary = details?.querySelector('summary');
  const hoverMode = window.matchMedia('(min-width: 768px) and (hover: hover)');
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  menu?.addEventListener('mouseenter', () => {
    if (!hoverMode.matches || !details) return;
    clearTimeout(closeTimer);
    details.open = true;
  });

  menu?.addEventListener('mouseleave', () => {
    if (!hoverMode.matches || !details) return;
    closeTimer = setTimeout(() => {
      details.open = false;
    }, 200);
  });

  // In hover mode a mouse click on the summary would toggle the menu closed
  // while still hovering; keyboard activation (event.detail === 0) keeps working.
  summary?.addEventListener('click', (event) => {
    if (hoverMode.matches && event.detail > 0) event.preventDefault();
  });
</script>
