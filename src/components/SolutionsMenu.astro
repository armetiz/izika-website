---
import { t, localizedPath, solutionPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const teamUrl = localizedPath('team', locale);

// Same entries as the old solutions_menu.html.twig mega menu.
const soloItems = [
  {
    href: solutionPath('agents-immobilier-mandataires-immobilier', locale),
    icon: '/assets/solutions/menu/solo/agent-immobilier-mandataire.svg',
    title: 'Agent Immobilier',
    text: 'Agents & mandataires',
  },
  {
    href: solutionPath('agent-general-assurances', locale),
    icon: '/assets/solutions/menu/solo/agent-general-assurance.svg',
    title: "Agent Général d'assurances",
    text: 'Déplacements clients et IK sans saisie',
  },
  {
    href: solutionPath('professions-liberales', locale),
    icon: '/assets/solutions/menu/solo/professions-liberales.svg',
    title: 'Professions libérales',
    text: 'Médecins, kinés, infirmiers, avocats…',
  },
  {
    href: solutionPath('artisans-btp', locale),
    icon: '/assets/solutions/menu/solo/artisan-btp.svg',
    title: 'Artisans & BTP',
    text: 'Déplacements chantiers',
  },
  {
    href: solutionPath('consultants', locale),
    icon: '/assets/solutions/menu/solo/consultant.svg',
    title: 'Consultants',
    text: 'Vos trajets clients sans effort',
  },
];

const teamItems = [
  {
    href: teamUrl,
    icon: '/assets/solutions/menu/team/reseau-agences.svg',
    title: 'Réseaux d’agences',
    text: 'Suivi homogène des IK',
  },
  {
    href: teamUrl,
    icon: '/assets/solutions/menu/team/bank-insurance.svg',
    title: 'Banque & Assurance',
    text: "Gestion d'IK pour vos conseillers terrain",
  },
  {
    href: teamUrl,
    icon: '/assets/solutions/menu/team/administration.svg',
    title: 'Administrations',
    text: 'IK pour collectivités, associations, ...',
  },
  {
    href: teamUrl,
    icon: '/assets/solutions/menu/team/btp-services-techniques.svg',
    title: 'BTP / Services techniques',
    text: 'Gérez les trajets de vos équipes mobiles',
  },
  {
    href: teamUrl,
    icon: '/assets/solutions/menu/team/commerce-distribution-commercial.svg',
    title: 'Commerces & Distribution',
    text: 'Déplacements de vos équipes, simplifiés',
  },
];
---

<li class="group relative md:static">
  <details class="md:[&[open]>summary]:text-primary-hover">
    <summary
      class="flex cursor-pointer list-none items-center gap-1 py-2 font-bold hover:text-primary-hover md:py-0"
    >
      {dict.nav.solutions}
      <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </summary>
    <div
      class="mt-2 grid gap-6 rounded-lg bg-white p-4 md:absolute md:left-1/2 md:z-30 md:mt-4 md:w-[min(64rem,90vw)] md:-translate-x-1/2 md:grid-cols-3 md:border-t-2 md:border-primary md:p-8 md:shadow-card"
    >
      <div>
        <span class="mb-3 block text-sm font-bold uppercase tracking-wide">Solos et Indépendants</span>
        <ul class="space-y-1">
          {
            soloItems.map((item) => (
              <li>
                <a class="flex items-center gap-3 rounded-md p-2 hover:bg-beige/60" href={item.href}>
                  <img class="h-9 w-9" src={item.icon} alt="" loading="lazy" />
                  <span>
                    <span class="block font-semibold">{item.title}</span>
                    <span class="block text-sm text-ink/70">{item.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <span class="mb-3 block text-sm font-bold uppercase tracking-wide">PME et Équipes</span>
        <ul class="space-y-1">
          {
            teamItems.map((item) => (
              <li>
                <a class="flex items-center gap-3 rounded-md p-2 hover:bg-beige/60" href={item.href}>
                  <img class="h-9 w-9" src={item.icon} alt="" loading="lazy" />
                  <span>
                    <span class="block font-semibold">{item.title}</span>
                    <span class="block text-sm text-ink/70">{item.text}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="hidden md:block">
        <img
          class="mb-3 rounded-lg"
          src="/assets/landing-pages/icon_report-conformity.png"
          alt="Conforme aux règles fiscales"
          loading="lazy"
        />
        <p class="text-sm text-ink/70">
          izika est la solution de déclaration d'IK recommandée par les experts comptables pour les
          entrepreneurs et les PME.
        </p>
      </div>
    </div>
  </details>
</li>
