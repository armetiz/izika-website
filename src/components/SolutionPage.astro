---
import type { CollectionEntry } from 'astro:content';
import TrackedLink from './TrackedLink.astro';
import { localizedPath, type Locale } from '../i18n';
import { site } from '../config/site';
import { reviews } from '../data/reviews';

/**
 * Solution landing page — Astro port of _solutions_base.html.twig.
 * Sections: hero, feature highlights (checklist + signup card), benefits on
 * beige with alternating rows + Trustpilot testimonial, mid-page CTA band
 * (fixed copy, no per-page override existed in Twig), customer case with
 * 3 gains, testimonial and final CTA card.
 */
interface Props {
  data: CollectionEntry<'solutions'>['data'];
  slug: string;
  locale?: Locale;
}

const { data, locale = 'fr' } = Astro.props;
const { trackingContext, head, featureHighlights, benefits, customerCase } = data;

const secondaryCtaHref = head.secondaryCta
  ? localizedPath(head.secondaryCta.routeKey, locale)
  : null;

/* Styling for the rich-text fields (p/ul/li/strong HTML from the YAML). */
const richText =
  '[&_p]:mb-3 [&_ul]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_strong]:font-bold [&_strong]:text-ink';

const btnPrimary =
  'inline-block rounded-md bg-primary px-8 py-3 font-semibold text-ink shadow-card transition hover:bg-primary-hover hover:-translate-y-0.5';
---

<div>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-transparent to-soft-primary">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <span class="mb-2 block text-sm font-bold tracking-wide uppercase">
            {head.title1}
          </span>
          <h1 class="mb-3 text-3xl leading-tight font-bold md:text-4xl">{head.title2}</h1>
          <p class="mb-6 text-lg text-ink/80">{head.catch}</p>
          <div class="flex flex-wrap items-center gap-3">
            <TrackedLink
              eventId="cta_header"
              href={head.ctaHref ?? site.joinUrl}
              trackingContext={trackingContext}
              class={btnPrimary}
            >
              {head.primaryCtaText ?? 'Tester izika gratuitement'}
            </TrackedLink>
            {
              secondaryCtaHref && head.secondaryCta && (
                <a
                  href={secondaryCtaHref}
                  class="inline-flex items-center gap-1 px-4 py-3 font-semibold text-ink hover:text-primary-hover"
                >
                  {head.secondaryCta.text}
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div>
          <img
            class="w-full rounded-lg"
            src={head.image.src}
            alt={head.image.alt}
            title={head.image.title}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Feature highlights -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="mb-6 text-2xl font-bold md:text-3xl">{featureHighlights.title}</h2>
        <div class="space-y-5">
          {
            featureHighlights.items.map((item) => (
              <div class="flex gap-3">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary">
                  <svg
                    class="h-3.5 w-3.5 text-ink"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <div>
                  <p class="font-bold">{item.title}</p>
                  <p class="text-ink/80">{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="rounded-xl bg-beige p-6 text-center shadow-card lg:mx-auto lg:max-w-sm">
          <img
            class="mx-auto rounded-lg shadow-sm"
            src={featureHighlights.image.src}
            alt={featureHighlights.image.alt}
            title={featureHighlights.image.title}
          />
          <div class="px-2 pt-4">
            <h4 class="text-xl font-bold">Testez gratuitement</h4>
            <p class="mb-4 text-sm text-ink/70">
              Pas de besoin de carte de crédit &bull; Vos IK en 5 min
            </p>
            <TrackedLink
              eventId="cta_feature_highlights"
              trackingContext={trackingContext}
              class={btnPrimary}
            >
              {featureHighlights.ctaText ?? 'Tester izika'}
            </TrackedLink>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-soft-primary">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="mx-auto max-w-3xl py-8 text-center text-3xl font-bold">{benefits.title}</h2>

      {
        (benefits.items ?? []).map((item, index) => (
          <div class="py-8">
            <div class="grid items-center gap-10 lg:grid-cols-12">
              <div class:list={['lg:col-span-5', index % 2 === 1 && 'lg:order-2']}>
                <h3 class="mb-3 text-2xl font-bold">{item.title}</h3>
                <div class:list={['text-ink/80', richText]} set:html={item.text} />
              </div>
              <div class:list={['lg:col-span-7', index % 2 === 1 && 'lg:order-1']}>
                <img class="w-full rounded-lg" src={item.image} alt={item.imageAlt} />
              </div>
            </div>
          </div>
        ))
      }

      <!-- Benefits testimonial -->
      <div class="py-16">
        <div class="relative mx-auto max-w-xl">
          <figure class="absolute -top-10 -left-10 -z-10" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="200"
              height="200"
              viewBox="0 0 8 8"
            >
              <path
                fill="#fabd004a"
                opacity=".3"
                d="M3,1.3C2,1.7,1.2,2.7,1.2,3.6c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5 C1.4,6.9,1,6.6,0.7,6.1C0.4,5.6,0.3,4.9,0.3,4.5c0-1.6,0.8-2.9,2.5-3.7L3,1.3z M7.1,1.3c-1,0.4-1.8,1.4-1.8,2.3 c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5c-0.7,0-1.1-0.3-1.4-0.8 C4.4,5.6,4.4,4.9,4.4,4.5c0-1.6,0.8-2.9,2.5-3.7L7.1,1.3z"
              ></path>
            </svg>
          </figure>

          <blockquote class="mb-6 text-center text-xl leading-relaxed font-bold">
            “{benefits.testimonial.quote}”
          </blockquote>

          <div class="flex items-center justify-center gap-3">
            <img
              class="h-12 w-12 rounded-full object-cover"
              src={benefits.testimonial.avatar}
              alt={benefits.testimonial.avatarAlt}
            />
            <div>
              <p class="font-bold">{benefits.testimonial.name}</p>
              <p class="text-sm text-ink/60">{benefits.testimonial.companyTitle}</p>
            </div>
          </div>

          <!-- Trustpilot rating -->
          <div class="mt-6 flex items-center justify-center gap-3">
            <a class="text-3xl font-bold" href={reviews.trustpilotUrl} rel="nofollow">
              {reviews.ratingValue}
            </a>
            <div class="flex flex-col">
              <a
                class="text-primary"
                href={reviews.trustpilotUrl}
                rel="nofollow"
                aria-label={`Note ${reviews.ratingValue} sur ${reviews.bestRating}`}
              >
                <span aria-hidden="true">★★★★★</span>
              </a>
              <a class="text-sm underline" href={reviews.trustpilotUrl} rel="nofollow">
                Voir tous les avis
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid-page CTA band -->
  <section class="bg-primary">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div
        class="flex flex-col items-center gap-6 text-center lg:flex-row lg:justify-between lg:text-left"
      >
        <div class="max-w-xl">
          <h2 class="text-2xl font-bold">Votre temps est précieux !</h2>
          <p>
            Laissez izika faire vos indemnités kilométriques pour vous et utilisez votre temps
            autrement.
          </p>
        </div>
        <TrackedLink
          eventId="cta_mid"
          trackingContext={trackingContext}
          class="inline-block rounded-full bg-white px-8 py-3 font-semibold text-ink shadow-card transition hover:-translate-y-0.5"
        >
          S'inscrire maintenant
        </TrackedLink>
      </div>
    </div>
  </section>

  <!-- Customer case -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="mb-3 text-2xl font-bold md:text-3xl">{customerCase.title}</h2>
        <div class:list={['text-ink/80', richText]} set:html={customerCase.intro} />
      </div>
      <div class="lg:pl-4">
        <img
          class="w-full rounded-full"
          src={customerCase.avatar}
          alt={customerCase.avatarAlt}
        />
      </div>
    </div>

    <!-- Gains -->
    <div class="mt-14">
      <p class="mb-6 font-bold">{customerCase.gainsTitle}</p>
      <div class="grid gap-10 md:grid-cols-3">
        {
          customerCase.gains.map((gain) => (
            <div>
              <figure class="mb-3">
                <img width="71" src={gain.image} alt={gain.imageAlt} />
              </figure>
              <div class:list={['text-ink/80', richText]} set:html={gain.text} />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Customer case testimonial -->
    <div class="py-16">
      <div class="relative mx-auto max-w-2xl text-center">
        <figure class="absolute -top-10 -left-10 -z-10" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 8 8">
            <path
              fill="#fabd004a"
              opacity=".3"
              d="M3,1.3C2,1.7,1.2,2.7,1.2,3.6c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5 C1.4,6.9,1,6.6,0.7,6.1C0.4,5.6,0.3,4.9,0.3,4.5c0-1.6,0.8-2.9,2.5-3.7L3,1.3z M7.1,1.3c-1,0.4-1.8,1.4-1.8,2.3 c0,0.2,0,0.4,0.1,0.5c0.2-0.2,0.5-0.3,0.9-0.3c0.8,0,1.5,0.6,1.5,1.5c0,0.9-0.7,1.5-1.5,1.5c-0.7,0-1.1-0.3-1.4-0.8 C4.4,5.6,4.4,4.9,4.4,4.5c0-1.6,0.8-2.9,2.5-3.7L7.1,1.3z"
            ></path>
          </svg>
        </figure>

        <blockquote class="mb-6 text-lg leading-relaxed font-bold">
          {customerCase.testimonial.quote}
        </blockquote>

        <span class="block text-xl font-bold">{customerCase.testimonial.name}</span>
        <small class="text-ink/60">{customerCase.testimonial.companyTitle}</small>
      </div>
    </div>

    <!-- Final CTA card -->
    <div class="mx-auto lg:max-w-4xl">
      <div class="rounded-xl bg-primary p-6">
        <div
          class="flex flex-col items-center gap-4 text-center md:flex-row md:justify-between md:text-left"
        >
          <h3 class="text-xl font-bold">{customerCase.ctaBlock.text}</h3>
          <a
            class="inline-block shrink-0 rounded-md bg-white px-6 py-3 font-semibold text-ink shadow-card transition hover:-translate-y-0.5"
            href={customerCase.ctaBlock.buttonUrl ?? site.joinUrl}
          >
            {customerCase.ctaBlock.buttonText ?? 'Tester gratuitement'}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>
