---
import type { CollectionEntry } from 'astro:content';
import GradientHero from './GradientHero.astro';
import QuoteIcon from './QuoteIcon.astro';
import TrustpilotBadge from './TrustpilotBadge.astro';
import TrackedLink from './TrackedLink.astro';
import { t, getMarket, localizedPath, type MarketId } from '../i18n';
import { btnPill, btnPrimary, btnPrimaryCompact } from '../lib/cta';

/**
 * Solution landing page — Astro port of _solutions_base.html.twig.
 * Sections: hero, feature highlights (checklist + signup card), benefits on
 * beige with alternating rows + Trustpilot testimonial, mid-page CTA band
 * (fixed copy, no per-page override existed in Twig), customer case with
 * 3 gains, testimonial and final CTA card.
 */
interface Props {
  data: CollectionEntry<'solutions'>['data'];
  market: MarketId;
}

const { data, market } = Astro.props;
const { trackingContext, head, featureHighlights, benefits, customerCase } = data;
const dict = t(market);
const marketData = getMarket(market);

const secondaryCtaHref = head.secondaryCta
  ? localizedPath(head.secondaryCta.routeKey, market)
  : null;

/* Styling for the rich-text fields (p/ul/li/strong HTML from the YAML). */
const richText =
  '[&_p]:mb-3 [&_ul]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_strong]:font-bold [&_strong]:text-ink';

---

<div>
  <!-- Hero (no wave nor mt-lg-11 on the solution pages in the source theme) -->
  <GradientHero wave={false} size="short">
      <div class="grid items-center gap-10 md:grid-cols-2">
        <div>
          <span class="mb-2 block text-sm font-bold tracking-wide uppercase">
            {head.title1}
          </span>
          <h1 class="mb-3 text-[2.5rem] font-bold">{head.title2}</h1>
          <p class="mb-6 text-xl text-muted">{head.catch}</p>
          <div class="flex flex-wrap items-center gap-3">
            <TrackedLink
              eventId="cta_header"
              href={head.ctaHref ?? marketData.joinUrl}
              trackingContext={trackingContext}
              class={btnPrimary}
            >
              {head.primaryCtaText ?? dict.cta.try}
            </TrackedLink>
            {
              secondaryCtaHref && head.secondaryCta && (
                <a
                  href={secondaryCtaHref}
                  class="inline-flex items-center gap-1 px-4 py-3 font-bold text-ink hover:text-primary-hover"
                >
                  {head.secondaryCta.text}
                  <svg
                    class="h-4 w-4"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div>
          <img
            class="w-full rounded-lg"
            src={head.image.src}
            alt={head.image.alt}
            title={head.image.title}
          />
        </div>
      </div>
  </GradientHero>

  <!-- Feature highlights -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid items-center gap-10 md:grid-cols-12">
      <div class="md:col-span-7">
        <h2 class="mb-6 text-3xl font-bold">{featureHighlights.title}</h2>
        <div class="space-y-5">
          {
            featureHighlights.items.map((item) => (
              <div class="flex gap-3">
                <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary">
                  <svg
                    class="h-3.5 w-3.5 text-ink"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                <div>
                  <p class="font-bold">{item.title}</p>
                  <p class="text-muted">{item.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="rounded-card bg-soft-neutral p-6 text-center lg:mx-auto lg:max-w-sm">
          <img
            class="mx-auto rounded-lg shadow-sm"
            src={featureHighlights.image.src}
            alt={featureHighlights.image.alt}
            title={featureHighlights.image.title}
          />
          <div class="px-2 pt-4">
            <h4 class="text-lg font-bold">{dict.solutionPage.signupTitle}</h4>
            <p class="mb-4 text-sm text-muted">{dict.solutionPage.signupText}</p>
            <TrackedLink
              eventId="cta_feature_highlights"
              trackingContext={trackingContext}
              class={btnPrimary}
            >
              {featureHighlights.ctaText ?? dict.cta.try}
            </TrackedLink>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="bg-soft-primary">
    <div class="mx-auto max-w-6xl px-4 py-8">
      <h2 class="mx-auto max-w-3xl py-8 text-center text-[2.5rem] font-bold">{benefits.title}</h2>

      {
        (benefits.items ?? []).map((item, index) => (
          <div class="py-8">
            <div class="grid items-center gap-10 lg:grid-cols-12">
              <div class:list={['lg:col-span-5', index % 2 === 1 && 'lg:order-2']}>
                <h3 class="mb-3 text-3xl font-bold">{item.title}</h3>
                <div class:list={['text-muted', richText]} set:html={item.text} />
              </div>
              <div class:list={['lg:col-span-7', index % 2 === 1 && 'lg:order-1']}>
                <img class="w-full rounded-lg" src={item.image} alt={item.imageAlt} />
              </div>
            </div>
          </div>
        ))
      }

      <!-- Benefits testimonial -->
      <div class="py-16">
        <div class="relative mx-auto max-w-xl">
          <figure class="absolute -top-10 -left-10 -z-10" aria-hidden="true">
            <QuoteIcon size={200} fillClass="fill-primary-band" opacity=".3" />
          </figure>

          <blockquote class="mb-6 text-center text-[1.3125rem] leading-relaxed font-bold">
            “{benefits.testimonial.quote}”
          </blockquote>

          <div class="flex items-center justify-center gap-3">
            <img
              class="h-12 w-12 rounded-full object-cover"
              src={benefits.testimonial.avatar}
              alt={benefits.testimonial.avatarAlt}
            />
            <div>
              <p class="text-lg font-bold">{benefits.testimonial.name}</p>
              <p class="text-sm text-muted">{benefits.testimonial.companyTitle}</p>
            </div>
          </div>

          <!-- Trustpilot rating -->
          <div class="mt-6 text-center">
            <TrustpilotBadge market={market} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mid-page CTA band (.bg-primary is overridden to translucent #fabd004a in prod) -->
  <section class="bg-primary-band">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div
        class="flex flex-col items-center gap-6 text-center lg:flex-row lg:justify-between lg:text-left"
      >
        <div class="max-w-xl">
          <h2 class="text-3xl font-bold">{dict.solutionPage.bandTitle}</h2>
          <p>{dict.solutionPage.bandText}</p>
        </div>
        <TrackedLink
          eventId="cta_mid"
          trackingContext={trackingContext}
          class={btnPill}
        >
          {dict.cta.signupNow}
        </TrackedLink>
      </div>
    </div>
  </section>

  <!-- Customer case -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="mb-3 text-3xl font-bold">{customerCase.title}</h2>
        <div class:list={['text-muted', richText]} set:html={customerCase.intro} />
      </div>
      <div class="lg:pl-4">
        <img
          class="w-full rounded-full"
          src={customerCase.avatar}
          alt={customerCase.avatarAlt}
        />
      </div>
    </div>

    <!-- Gains -->
    <div class="mt-14">
      <p class="mb-6 font-bold">{customerCase.gainsTitle}</p>
      <div class="grid gap-10 md:grid-cols-3">
        {
          customerCase.gains.map((gain) => (
            <div>
              <figure class="mb-3">
                <img width="71" src={gain.image} alt={gain.imageAlt} />
              </figure>
              <div class:list={['text-muted', richText]} set:html={gain.text} />
            </div>
          ))
        }
      </div>
    </div>

    <!-- Customer case testimonial -->
    <div class="py-16">
      <div class="relative mx-auto max-w-2xl text-center">
        <figure class="absolute -top-10 -left-10 -z-10" aria-hidden="true">
          <QuoteIcon size={200} fillClass="fill-primary-band" opacity=".3" />
        </figure>

        <blockquote class="mb-6 text-xl leading-relaxed font-bold">
          {customerCase.testimonial.quote}
        </blockquote>

        <span class="block text-lg font-bold">{customerCase.testimonial.name}</span>
        <small class="text-muted">{customerCase.testimonial.companyTitle}</small>
      </div>
    </div>

    <!-- Final CTA card -->
    <div class="mx-auto lg:max-w-4xl">
      <!-- .card.bg-primary → translucent #fabd004a in prod -->
      <div class="rounded-card bg-primary-band p-6">
        <div
          class="flex flex-col items-center gap-4 text-center md:flex-row md:justify-between md:text-left"
        >
          <h3 class="text-[1.3125rem] font-bold">{customerCase.ctaBlock.text}</h3>
          <a
            class={btnPrimaryCompact}
            href={customerCase.ctaBlock.buttonUrl ?? marketData.joinUrl}
          >
            {customerCase.ctaBlock.buttonText ?? dict.cta.try}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>
