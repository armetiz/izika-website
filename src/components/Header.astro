---
import { t, localizedPath, type Locale } from '../i18n';
import { site } from '../config/site';
import { btnPrimarySm } from '../lib/cta';
import SolutionsMenu from './SolutionsMenu.astro';
import TrackedLink from './TrackedLink.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
---

<header class="sticky top-0 z-40 bg-white/95 shadow-sm backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={localizedPath('home', locale)} aria-label="IZIKA" class="shrink-0">
      <img src="/assets/img/logo/izika-logo.png" alt="Logo izika" width="159" height="56" class="h-10 w-auto" />
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="rounded-md border border-beige-line p-2 md:hidden"
      aria-label="Ouvrir la navigation"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          fill="currentColor"
          d="M17.4,6.2H0.6C0.3,6.2,0,5.9,0,5.5V4.1c0-0.4,0.3-0.7,0.6-0.7h16.9c0.3,0,0.6,0.3,0.6,0.7v1.4C18,5.9,17.7,6.2,17.4,6.2z M17.4,14.1H0.6c-0.3,0-0.6-0.3-0.6-0.7V12c0-0.4,0.3-0.7,0.6-0.7h16.9c0.3,0,0.6,0.3,0.6,0.7v1.4C18,13.7,17.7,14.1,17.4,14.1z"
        ></path>
      </svg>
    </button>

    <nav id="main-nav" class="hidden w-full md:block md:w-auto">
      <ul class="flex flex-col gap-2 pt-4 font-bold md:flex-row md:items-center md:gap-6 md:pt-0">
        <li>
          <a class="block py-2 hover:text-primary-hover md:py-0" href={localizedPath('features', locale)}>
            {dict.nav.features}
          </a>
        </li>
        <SolutionsMenu locale={locale} />
        <li>
          <a class="block py-2 hover:text-primary-hover md:py-0" href={localizedPath('pricing', locale)}>
            Nos offres et tarifs
          </a>
        </li>
        <li>
          <a
            class="btn-3d inline-block rounded-card border border-primary px-[1.125rem] py-2.5 text-sm text-primary"
            href={site.appUrl}
          >
            {dict.nav.login}
          </a>
        </li>
        <li>
          <TrackedLink eventId="cta_menu" class={btnPrimarySm}>
            Tester izika
          </TrackedLink>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
