---
import StandardLayout from './StandardLayout.astro';
import TrackedLink from '../components/TrackedLink.astro';
import Card from '../components/Card.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { articleSchema, breadcrumbSchema } from '../seo/schema';
import { btnPill } from '../lib/cta';
import { getCollection } from 'astro:content';
import { t, getMarket, MARKETS, articlePath, localizedPath, type MarketId } from '../i18n';
import type { MarkdownHeading } from 'astro';

interface Props {
  market: MarketId;
  title: string;
  description: string;
  date: Date;
  image?: string;
  robots?: string;
  toc?: boolean;
  headings?: MarkdownHeading[];
  /** Articles of different markets sharing this key are hreflang alternates. */
  hreflangKey?: string;
}

const { market, title, description, date, image, robots, toc = false, headings = [], hreflangKey } =
  Astro.props;
const dict = t(market);

// hreflang alternates via hreflangKey — zero emission while the key exists in
// fewer than 2 markets (same rule as Seo.astro for editorial routes).
const siblings = hreflangKey
  ? (await getCollection('articles', (a) => a.data.hreflangKey === hreflangKey)).map((a) => {
      const [m, ...rest] = a.id.split('/');
      return { market: m as MarketId, href: articlePath(rest.join('/'), m as MarketId) };
    })
  : [];
const articleAlternates = siblings.length >= 2 ? siblings : [];

// Same default og:image as the old page.html.twig.
const ogImage = image ? `/${image.replace(/^\//, '')}` : '/content/pages/bareme-indemnite-kilometrique.jpg';

const canonical = new URL(
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, ''),
  Astro.site,
).href;
const homeUrl = new URL(localizedPath('home', market)!, Astro.site).href;

const schemaNodes = [
  articleSchema(getMarket(market), { url: canonical, title, description, datePublished: date, image: ogImage }),
  breadcrumbSchema([
    { name: dict.article.breadcrumbHome, url: homeUrl },
    { name: title, url: canonical },
  ]),
];
---

<StandardLayout
  market={market}
  title={title}
  description={description}
  image={ogImage}
  robots={robots}
  ogType="article"
  articlePublishedTime={date}
  schemaNodes={schemaNodes}
>
  <Fragment slot="head">
    {
      articleAlternates.map((a) => (
        <link
          rel="alternate"
          href={new URL(a.href, Astro.site).href}
          hreflang={MARKETS[a.market].hreflang}
        />
      ))
    }
  </Fragment>

  <!-- Top CTA banner (same copy as page.html.twig) -->
  <div class="mx-auto max-w-6xl px-4 pt-8 pb-16 md:pt-16">
    <div class="rounded-card bg-beige-light p-10">
      <div class="flex flex-col items-center gap-6 text-center lg:flex-row lg:justify-between lg:text-left">
        <div>
          <p class="text-3xl font-bold">{dict.article.ctaTitle}</p>
          <p class="mb-0">{dict.article.ctaText}</p>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          <TrackedLink
            eventId="cta_block_cta"
            class={btnPill}
          >
            {dict.cta.join}
          </TrackedLink>
          <a
            class="btn-3d min-w-40 rounded-full bg-white px-4 py-3 text-center font-bold"
            href={localizedPath('home', market)}
          >
            {dict.article.ctaMore}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-8 pb-16">
    {toc && headings.length > 0 && <TableOfContents headings={headings} title={dict.article.tocTitle} />}
    <article class="prose prose-izika mx-auto lg:max-w-[85%]">
      <slot />
    </article>
  </div>

  <!-- Bottom CTA card -->
  <div class="mx-auto max-w-6xl px-4 pb-16">
    <Card class="relative mx-auto lg:max-w-[85%]" bodyClass="p-8">
      <div class="flex flex-col items-center gap-4 text-center md:flex-row md:justify-between md:text-left">
        <h3 class="text-lg font-bold">{dict.article.bottomTitle}</h3>
        <a
          class="btn-3d shrink-0 rounded-card bg-primary px-4 py-3 font-bold text-white hover:bg-primary-hover"
          href={localizedPath('home', market)}
        >
          {dict.article.bottomButton}
        </a>
      </div>
    </Card>
  </div>
</StandardLayout>
