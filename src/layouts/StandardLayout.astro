---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof BaseLayout> & {
  /** Forwarded to Footer — landing pages use 'gradient' or 'soft'. */
  footerBackground?: ComponentProps<typeof Footer>['background'];
};

const { footerBackground, ...props } = Astro.props;
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <Header locale={props.locale} />
  <!-- Vertical rhythm is owned by each page's sections (like the old .space-* utilities). -->
  <main>
    <slot />
  </main>
  <Footer locale={props.locale} background={footerBackground} />
</BaseLayout>
