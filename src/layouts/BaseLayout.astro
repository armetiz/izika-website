---
import '../styles/global.css';
import Seo from '../components/head/Seo.astro';
import JsonLd from '../components/head/JsonLd.astro';
import Analytics from '../components/head/Analytics.astro';
import { graph, organizationSchema, webSiteSchema } from '../seo/schema';
import type { RouteKey } from '../i18n';
import { getMarket, type MarketId } from '../i18n';

interface Props {
  market: MarketId;
  title: string;
  /** Falls back to the market's defaultDescription in Seo.astro. */
  description?: string;
  routeKey?: RouteKey;
  image?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: Date;
  /** Page-specific JSON-LD nodes merged into the shared @graph. */
  schemaNodes?: Array<Record<string, unknown>>;
}

const {
  market,
  title,
  description,
  routeKey,
  image,
  robots,
  ogType,
  articlePublishedTime,
  schemaNodes = [],
} = Astro.props;

const marketData = getMarket(market);
const schema = graph(organizationSchema(marketData), webSiteSchema(marketData), ...schemaNodes);

const pageViewPayload = JSON.stringify({ name: 'pageViewed', properties: {} });
---

<!doctype html>
<html lang={getMarket(market).language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      market={market}
      title={title}
      description={description}
      routeKey={routeKey}
      image={image}
      robots={robots}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
    />
    <JsonLd schema={schema} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- TrustBox script — only for markets that render the widget itself;
         a market with badges but no widget (widgetLocale: null) must not pay
         for the bootstrap. -->
    {
      marketData.trustpilot?.widgetLocale && (
        <script
          is:inline
          type="text/javascript"
          src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"
          async
        />
      )
    }

    <slot name="head" />
  </head>
  <body data-track-page-view={pageViewPayload}>
    <slot />
    <Analytics cookiesVersion={marketData.cookiesVersion} />
  </body>
</html>
