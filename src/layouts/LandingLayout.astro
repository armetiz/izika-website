---
// Landing pages share the standard chrome today; this thin alias keeps the
// door open for landing-specific chrome (e.g. marketing alert banner) without
// touching content pages.
import StandardLayout from './StandardLayout.astro';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof StandardLayout>;

const props = Astro.props;
---

<StandardLayout {...props}>
  <slot name="head" slot="head" />
  <slot />
</StandardLayout>
