---
// In production, Cloudflare's `_redirects` 301s `/` to `/fr` before this
// file is ever served. This meta-refresh only covers the local dev server.
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/fr" />
    <meta name="robots" content="noindex" />
    <title>izika</title>
  </head>
  <body>
    <a href="/fr">izika</a>
  </body>
</html>
