---
import StandardLayout from '../../layouts/StandardLayout.astro';
import LegalShell from '../../components/LegalShell.astro';
import { localizedPath } from '../../i18n';

// ⚠️ COURTESY TRANSLATION of src/pages/fr/cgv.astro — to be reviewed by
// legal counsel before going live. French law remains the applicable law and
// the French version prevails (stated on the page).

const articleTitles = [
  'PREAMBLE',
  'DEFINITIONS',
  'PURPOSE',
  'TERM',
  'PRE-CONTRACTUAL INFORMATION',
  'DESCRIPTION OF THE APPLICATION SERVICES',
  'TECHNICAL PREREQUISITES',
  'NETWORK AND ACCESS TO IZIKA',
  'SECURING ACCESS TO IZIKA',
  'EQUIPMENT PROTECTION',
  'QUALITY OF SERVICES',
  'SUSPENSION OF SERVICES',
  'MAINTENANCE AND SUPPORT',
  'LICENCE TO USE',
  'PERSONAL DATA',
  'DATA SECURITY',
  'FINANCIAL TERMS',
  'OWNERSHIP',
  'THIRD-PARTY RIGHTS',
  'WARRANTY AGAINST INFRINGEMENT',
  'LIABILITY',
  'FORCE MAJEURE',
  'INSURANCE',
  'TERMINATION',
  'REVERSIBILITY',
  'CONFIDENTIALITY',
  'PERSONAL DATA – RIGHT OF ACCESS',
  'MISCELLANEOUS',
  'APPLICABLE LAW – ARBITRATION – JURISDICTION',
] as const;

const toc = articleTitles.map((title, i) => ({
  href: `#article-${i + 1}`,
  label: `${i + 1}. ${title}`,
}));
---

<StandardLayout market="en" routeKey="terms" title="Terms of Sale">
