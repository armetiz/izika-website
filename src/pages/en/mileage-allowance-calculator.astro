---
import { badgePill, badgePillInline, checkBullet, eyebrow, tableClass, thClass, tdClass } from '../../lib/ui';
import StandardLayout from '../../layouts/StandardLayout.astro';
import Card from '../../components/Card.astro';
import CtaCalendarCard from '../../components/CtaCalendarCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import GradientHero from '../../components/GradientHero.astro';
import MileageCalculatorUK from '../../components/MileageCalculatorUK.tsx';
import { faqPageSchema } from '../../seo/schema';
import { faqCalculatorEntries } from '../../data/faq-calculator.en';
import { PASSENGER_RATE, RATES, computeMileage } from '../../data/mileage-uk';
import { makeFormatters, pence } from '../../lib/format';
import { articlePath, getMarket } from '../../i18n';

// Pre-rendered at build time: the educational content (steps, rate tables,
// worked example, FAQ) is generated from src/data/mileage-uk.ts — only the
// calculator is a client-hydrated React island. English counterpart of
// /fr/calculateur-indemnites-kilometriques, built on the UK HMRC AMAP scheme
// (progressive bands, miles, GBP) instead of the French barème.

const trackingContext = 'page_calculator';

const description =
  'Work out your 2026/27 mileage allowance with the official HMRC approved rates: car, van, motorcycle or bicycle, per week, month or year. Free calculator, rates and rules explained.';

const market = getMarket('en');
// The island and the tables format in GBP regardless of the market's pricing
// currency — the AMAP scheme is a UK scheme.
const fmt = makeFormatters({ numberLocale: market.numberLocale, currency: 'GBP' });
const { formatCurrency, formatNumber } = fmt;

const currentRates = RATES['2026/27'];
const vehicles = [
  { ...currentRates.carVan, plural: 'Cars and vans' },
  { ...currentRates.motorcycle, plural: 'Motorcycles' },
  { ...currentRates.bicycle, plural: 'Bicycles' },
];

// Worked example pre-computed at build time with the same maths as the
// island: 250 miles/week by car, 2026/27 rates.
const example = computeMileage({
  vehicle: 'carVan',
  taxYear: '2026/27',
  miles: 250,
  period: 'week',
})!;

const steps = [
  {
    bg: 'bg-soft-primary',
    title: 'Your distance is annualised',
    subtitle: 'Week × 52, month × 12.',
    text: 'The approved rates work per tax year (6 April to 5 April): 250 miles a week become 13,000 miles over the year.',
  },
  {
    bg: 'bg-soft-neutral',
    title: 'The 10,000-mile threshold splits it',
    subtitle: 'Two bands for cars and vans.',
    text: 'The first 10,000 business miles are paid at the headline rate, every mile above at the reduced rate. Motorcycles and bicycles have one flat rate.',
  },
  {
    bg: 'bg-soft-neutral',
    title: 'The approved rate applies',
    subtitle: 'miles × rate, per band.',
    text: `Cars and vans: ${pence(currentRates.carVan.bands[0].rate)} then ${pence(currentRates.carVan.bands[1].rate)}. Motorcycles ${pence(currentRates.motorcycle.bands[0].rate)}, bicycles ${pence(currentRates.bicycle.bands[0].rate)} — whatever the fuel, electric included.`,
  },
  {
    bg: 'bg-beige-dark',
    title: `+ ${pence(PASSENGER_RATE)} per passenger mile`,
    subtitle: 'Cars and vans only.',
    text: 'Carrying a colleague on a journey that is also a business journey for them adds 5p per passenger per mile, tax-free.',
  },
] as const;

---

<StandardLayout
  market="en"
  routeKey="calculator"
  title="Mileage Allowance Calculator (UK)"
  description={description}
  schemaNodes={[faqPageSchema(faqCalculatorEntries)]}
>
  <!-- Hero (same construction as the features page) -->
  <GradientHero class="text-center">
    <div class="mx-auto max-w-3xl">
      <p class={eyebrow}>
        Free calculator — official HMRC approved rates
      </p>
      <h1 class="text-[2.5rem] font-bold">Mileage allowance calculator</h1>
      <p class="mt-4 text-lg">
        Car, van, motorcycle or bicycle: pick your vehicle and your business miles — the tax-free
        amount appears with the calculation detailed step by step, at the 2026/27 rates.
      </p>
    </div>
  </GradientHero>

  <!-- Calculator (React island), pulled up over the wave -->
  <section class="relative z-10 mx-auto -mt-12 max-w-5xl px-4 pb-4">
    <MileageCalculatorUK
      client:load
      numberLocale={market.numberLocale}
      currency="GBP"
      joinUrl={market.joinUrl}
    />
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-bold">How is the amount worked out?</h2>
      <p class="mt-3 text-muted">
        The HMRC approved amount is computed <strong>per tax year</strong>, <strong>per mileage
        band</strong> and <strong>per vehicle type</strong>. The calculator applies exactly the
        HMRC method, in four steps.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <div class:list={['rounded-card p-6', step.bg]}>
          <p class="text-xs font-bold tracking-wide text-muted uppercase">Step {i + 1}</p>
          <h3 class="mt-1 text-lg font-bold">{step.title}</h3>
          <p class="mt-1 mb-3 text-sm italic">{step.subtitle}</p>
          <p class="text-sm">{step.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Rate tables -->
  <section class="mx-auto max-w-5xl px-4 pb-16">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <h2 class="text-3xl font-bold">
        The approved mileage rates in detail
        <span class={badgePillInline}>
          2026/27
        </span>
      </h2>
      <p class="mt-3 text-muted">
        First rise since 2011/12: the car and van headline rate went from 45p
        to <strong>55p</strong>, announced on 21 May 2026 and applying retrospectively from
        6&nbsp;April&nbsp;2026. The rates apply whatever the fuel — electric and hybrid included.
      </p>
    </div>

    <div class="space-y-10">
      <div>
        <h3 class="text-[1.3125rem] font-bold">Approved rates per business mile</h3>
        <div class="mt-4 overflow-x-auto rounded-card bg-white shadow-card">
          <table class={tableClass}>
            <thead>
              <tr>
                <th class={thClass} scope="col">Vehicle</th>
                <th class={thClass} scope="col">First 10,000 miles</th>
                <th class={thClass} scope="col">Above 10,000 miles</th>
              </tr>
            </thead>
            <tbody>
              {vehicles.map((vehicle) => (
                <tr>
                  <th class={thClass} scope="row">{vehicle.plural}</th>
                  <td class={tdClass}>{pence(vehicle.bands[0].rate)} per mile</td>
                  <td class={tdClass}>
                    {pence((vehicle.bands[1] ?? vehicle.bands[0]).rate)} per mile
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="text-[1.3125rem] font-bold">Previous tax years (2011/12 to 2025/26)</h3>
        <div class="mt-4 overflow-x-auto rounded-card bg-white shadow-card">
          <table class={tableClass}>
            <thead>
              <tr>
                <th class={thClass} scope="col">Vehicle</th>
                <th class={thClass} scope="col">First 10,000 miles</th>
                <th class={thClass} scope="col">Above 10,000 miles</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th class={thClass} scope="row">Cars and vans</th>
                <td class={tdClass}>45p per mile</td>
                <td class={tdClass}>25p per mile</td>
              </tr>
              <tr>
                <th class={thClass} scope="row">Motorcycles</th>
                <td class={tdClass}>24p per mile</td>
                <td class={tdClass}>24p per mile</td>
              </tr>
              <tr>
                <th class={thClass} scope="row">Bicycles</th>
                <td class={tdClass}>20p per mile</td>
                <td class={tdClass}>20p per mile</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <p class="rounded-card bg-soft-primary px-6 py-5 text-center">
        <strong>Passenger payments:</strong> add {pence(PASSENGER_RATE)} per passenger per business
        mile for colleagues travelling with you in a car or van. Payments within the approved
        amounts are free of income tax and National Insurance.
      </p>
    </div>
  </section>

  <!-- Worked example -->
  <section class="overflow-hidden bg-beige-light py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class={eyebrow}>A concrete example</p>
          <h2 class="mb-6 text-3xl font-bold">
            250&nbsp;miles a week by car, 2026/27 rates
          </h2>

          <ol class="space-y-3">
            <li class="flex items-start gap-3">
              <span class={checkBullet} aria-hidden="true">1</span>
              <p>
                Annualised distance: 250&nbsp;miles × 52 =
                <strong> {formatNumber(example.annualMiles)}&nbsp;miles</strong> per tax year.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <span class={checkBullet} aria-hidden="true">2</span>
              <p>
                First band: {formatNumber(example.bands[0].miles)} miles ×
                {pence(example.bands[0].rate)} =
                <strong> {formatCurrency(example.bands[0].amount)}</strong>.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <span class={checkBullet} aria-hidden="true">3</span>
              <p>
                Above 10,000 miles: {formatNumber(example.bands[1].miles)} miles ×
                {pence(example.bands[1].rate)} =
                <strong> {formatCurrency(example.bands[1].amount)}</strong>.
              </p>
            </li>
            <li class="flex items-start gap-3">
              <span class={checkBullet} aria-hidden="true">4</span>
              <p>
                Approved amount: <strong>{formatCurrency(example.total)}</strong> — tax-free if
                your employer reimburses within it.
              </p>
            </li>
          </ol>

          <p class="mt-6">
            All of it free of income tax and National Insurance — provided every business journey
            is recorded (date, start and end points, distance, business purpose).
          </p>
        </div>

        <!-- Result-card style summary -->
        <Card bodyClass="p-6 lg:p-8">
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-bold text-ink">Annual allowance</h3>
            <span class={badgePill}>
              2026/27 rates
            </span>
          </div>
          <p class="mt-4 rounded-card bg-soft-primary px-6 py-5 text-center">
            <span class="block text-4xl font-bold text-ink">{formatCurrency(example.total)}</span>
            <span class="mt-1 block text-sm text-muted">
              that's {formatCurrency(example.total / 12)} / month
            </span>
          </p>
          <dl class="mt-5 space-y-2 text-sm">
            <div class="flex items-baseline justify-between gap-4">
              <dt>{formatNumber(example.bands[0].miles)} miles × {pence(example.bands[0].rate)}</dt>
              <dd class="font-bold text-ink">{formatCurrency(example.bands[0].amount)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt>{formatNumber(example.bands[1].miles)} miles × {pence(example.bands[1].rate)}</dt>
              <dd class="font-bold text-ink">+ {formatCurrency(example.bands[1].amount)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-t border-beige-line pt-2">
              <dt class="font-bold text-ink">Tax-free total</dt>
              <dd class="font-bold text-ink">{formatCurrency(example.total)}</dd>
            </div>
          </dl>
        </Card>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-3xl px-4 py-16">
    <div class="mx-auto mb-8 max-w-2xl text-center">
      <h2 class="text-3xl font-bold">Frequently asked questions about mileage allowances</h2>
    </div>
    <FaqAccordion entries={faqCalculatorEntries} />
    <p class="mt-6 text-center text-sm text-muted">
      Full details in our
      article: <a class="underline" href={articlePath('hmrc-mileage-rates-2026', 'en')}>HMRC mileage rates 2026/27</a>
    </p>
  </section>

  <!-- CTA (same construction as the features page, calendar illustration included) -->
  <section class="mx-auto max-w-5xl px-4 pb-16">
    <CtaCalendarCard
      title="Tired of working out your mileage by hand?"
      ctaLabel="Create your account"
      trackingContext={trackingContext}
    >
      izika detects your business trips from your online calendar and generates your mileage
      report — current rates and supporting records included.
    </CtaCalendarCard>
  </section>
</StandardLayout>
