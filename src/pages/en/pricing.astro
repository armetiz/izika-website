---
import StandardLayout from '../../layouts/StandardLayout.astro';
import GradientHero from '../../components/GradientHero.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { btnPrimarySm } from '../../lib/cta';
import { localizedPath, getMarket } from '../../i18n';
import { webApplicationSchema } from '../../seo/schema';

// English translation of src/pages/fr/pricing.astro. Same EUR price grid as
// the fr market; no Trustpilot block (market.trustpilot is null for en).

interface PricingTier {
  name: string;
  /** Suffix appended after the name (Solo ∞). */
  infinity?: boolean;
  price: string;
}

// Currency symbol before the amount, English style (€99), unlike the fr page.
const tiers: ReadonlyArray<PricingTier> = [
  { name: 'Solo', price: 'Free' },
  { name: 'Solo', infinity: true, price: '€99 /year' },
  { name: 'Team', price: '€10 /month /user' },
];

/**
 * One cell per tier: 'yes' → green check, 'no' → dash,
 * { limited } → red cross with a note underneath.
 */
type Cell = 'yes' | 'no' | { limited: string };

interface FeatureSection {
  title: string;
  rows: ReadonlyArray<{ label: string; cells: readonly [Cell, Cell, Cell] }>;
}

const featureSections: ReadonlyArray<FeatureSection> = [
  {
    title: 'Driver features',
    rows: [
      { label: 'Unlimited trips', cells: [{ limited: '10 trips/month' }, 'yes', 'yes'] },
      { label: 'Automatic distance calculation', cells: ['yes', 'yes', 'yes'] },
      { label: 'Supporting documents', cells: ['yes', 'yes', 'yes'] },
      { label: 'Monthly provision management', cells: ['yes', 'yes', 'no'] },
      { label: 'Calendar synchronization', cells: ['yes', 'yes', 'yes'] },
      { label: 'Favourite addresses', cells: ['yes', 'yes', 'yes'] },
      { label: 'Multi-vehicle management / electric vehicle scale', cells: ['yes', 'yes', 'yes'] },
      { label: 'Default travel behaviour settings (star pattern/round trip)', cells: ['yes', 'yes', 'yes'] },
    ],
  },
  {
    title: 'Company features',
    rows: [
      { label: 'User management (teams/supervisors)', cells: ['no', 'no', 'yes'] },
      { label: 'Approval workflows (approve, reject, flag errors)', cells: ['no', 'no', 'yes'] },
      { label: 'Complete custom exports (analytical accounting)', cells: ['no', 'no', 'yes'] },
    ],
  },
];

const subscriptionFaq: ReadonlyArray<{ question: string; answer: string }> = [
  {
    question: 'Can I cancel my subscription?',
    answer: `<p>
        Yes, you can cancel your subscription whenever you want, by email or from the application.
        You will keep access to the application until the end of your subscription period.
    </p>`,
  },
  {
    question: 'Do you have a refund policy?',
    answer: `<p>If you are not satisfied — and even though it is not systematic — we can issue a refund.</p>`,
  },
  {
    question: 'How does billing work?',
    answer: `<p>Entrepreneurs choosing IZIKA Solo get one yearly invoice per user;
        the subscription renews automatically and you can cancel the renewal at any
        time.
        Fleet managers who opt for IZIKA Team get a monthly invoice for each user
        and a yearly invoice for the Manager account.
        The subscription can also be cancelled at any time.</p>`,
  },
  {
    question: 'What about security and privacy?',
    answer: `<p>
        IZIKA SAS is a French company founded in 2014; we follow a strict
        <a href="${localizedPath('security', 'en')}" class="underline">security policy</a> that we apply scrupulously.
    </p>`,
  },
  {
    question: 'Can I manage my mileage allowances for past years?',
    answer: `<p>Yes, by subscribing you get access to the whole current year as well as the 3 previous years,
        provided your calendar allows it (iCloud calendars, for instance, do not).</p>`,
  },
];

const featureCards: ReadonlyArray<{
  icon: string;
  alt: string;
  title: string;
  badge?: string;
  text: string;
}> = [
  {
    icon: '/assets/landing-pages/icon_cal-to-rdv.png',
    alt: 'Appointments imported from the calendar',
    title: 'Automatic entry',
    text: 'izika automatically imports your appointments from your electronic calendar.',
  },
  {
    icon: '/assets/landing-pages/icon_km-auto.png',
    alt: 'Automatic distance calculation',
    title: 'Automatic calculations',
    text: 'izika automatically computes the distances and the amount of your mileage allowances without leaving the application.',
  },
  {
    icon: '/assets/landing-pages/icon_report-conformity.png',
    alt: 'Compliant with tax rules',
    title: 'Tax compliance',
    text: 'izika is approved and validated by chartered accountants and the tax administration.',
  },
  {
    icon: '/assets/landing-pages/icon_team.png',
    alt: 'Vehicle fleet management',
    title: 'Fleet management',
    badge: 'team',
    text: 'izika team is the only tool managing mileage allowance approval workflows for companies.',
  },
];
---

<StandardLayout
  market="en"
  routeKey="pricing"
  title="Plans and pricing"
  description="Simplify your mileage expenses with the most efficient software on the market."
  schemaNodes={[webApplicationSchema(getMarket('en'))]}
>
  <!-- Hero -->
  <GradientHero class="text-center">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-bold">
        Simplify your mileage expenses with the most efficient software on the market.
      </h1>
    </div>
  </GradientHero>

  <!-- Pricing section -->
  <section id="fullPricingSection" class="mx-auto max-w-6xl px-4 py-16">
    <!-- Comparison table -->
    <div class="overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-left">
        <thead class="text-center">
          <tr>
            <th scope="col" class="w-2/5"></th>
            {tiers.map((tier) => (
              <th scope="col" class="w-1/5 border-x border-beige-line px-3 py-4 first:border-l-0 last:border-r-0">
                <span class="block text-[1.3125rem] font-bold">
                  {tier.name}
                  {tier.infinity && <span aria-label="unlimited"> ∞</span>}
                </span>
                <span class="block text-lg font-normal">{tier.price}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {featureSections.map((section) => (
            <>
              <tr class="border-y border-beige-line">
                <th scope="row" class="px-4 pt-8 pb-3 text-lg font-bold" colspan="4">{section.title}</th>
              </tr>
              {section.rows.map((row, i) => (
                <tr class={i % 2 === 0 ? 'bg-beige/50' : ''}>
                  <th scope="row" class="px-4 py-3 text-sm font-semibold">{row.label}</th>
                  {row.cells.map((cell) => (
                    <td class="border-x border-beige-line p-3 text-center first:border-l-0 last:border-r-0">
                      {cell === 'yes' && <span class="font-bold text-success" aria-label="included">✓</span>}
                      {cell === 'no' && <span aria-label="not included">-</span>}
                      {typeof cell === 'object' && (
                        <>
                          <span class="font-bold text-danger" aria-label="limited">✕</span>
                          <br />
                          <small>{cell.limited}</small>
                        </>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Features section -->
  <section id="featuresSection" class="mx-auto max-w-6xl px-4 pb-16 lg:pb-32">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {featureCards.map((card) => (
        <FeatureCard icon={card.icon} iconAlt={card.alt} title={card.title} badge={card.badge}>
          {card.text}
        </FeatureCard>
      ))}
    </div>
    <div class="my-12 text-center">
      <a
        class={btnPrimarySm}
        href={localizedPath('features', 'en')}
        target="_blank"
        rel="noopener"
      >
        Discover all the features <span aria-hidden="true">›</span>
      </a>
    </div>
  </section>

  <!-- FAQ section -->
  <section class="mx-auto max-w-4xl px-4 pb-16 lg:pb-32">
    <div class="mx-auto mb-10 text-center">
      <h2 class="text-3xl font-bold">Frequently asked questions about the subscription</h2>
    </div>

    <FaqAccordion entries={subscriptionFaq} />
  </section>
</StandardLayout>
