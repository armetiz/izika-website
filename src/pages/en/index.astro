---
import StandardLayout from '../../layouts/StandardLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { homePageEn } from '../../data/home-page.en';
import { featureCardsEn } from '../../data/feature-cards.en';
import { webApplicationSchema } from '../../seo/schema';
import { getMarket } from '../../i18n';

// No Trustpilot blocks (market.trustpilot is null) and no French video demo.
---

<StandardLayout
  market="en"
  title="Automatic mileage allowance management"
  description="izika is Europe's #1 mileage allowance management application for freelancers and teams"
  routeKey="home"
  schemaNodes={[webApplicationSchema(getMarket('en'))]}
>
  <HomePage market="en" copy={homePageEn} featureCards={featureCardsEn} />
</StandardLayout>
