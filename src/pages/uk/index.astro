---
import StandardLayout from '../../layouts/StandardLayout.astro';
import HomePage from '../../components/templates/HomePage.astro';
import { homePageUk } from '../../data/home-page.uk';
import { featureCardsUk } from '../../data/feature-cards.uk';
import { webApplicationSchema } from '../../seo/schema';
import { getMarket } from '../../i18n';

// No Trustpilot blocks (market.trustpilot is null) and no French video demo.
---

<StandardLayout
  market="uk"
  title="Automatic mileage allowance management"
  description="izika is Europe's #1 mileage allowance management application for freelancers and teams"
  routeKey="home"
  schemaNodes={[webApplicationSchema(getMarket('uk'))]}
>
  <HomePage market="uk" copy={homePageUk} featureCards={featureCardsUk} />
</StandardLayout>
