---
import StandardLayout from '../../layouts/StandardLayout.astro';
import TeamLanding from '../../components/templates/TeamLanding.astro';
import LandingClosingCta from '../../components/sections/LandingClosingCta.astro';
import { teamLandingUk } from '../../data/team-landing.uk';

// English counterpart of src/pages/fr/team-collectivites.astro.
---

<StandardLayout
  market="uk"
  title="Mileage allowance management for local authorities"
  description="Simplify mileage allowance calculation for your employees"
  routeKey="teamCollectivites"
  footerBackground="soft"
>
  <TeamLanding audience="local authorities" trackingContext="page_collectivites" copy={teamLandingUk} />

  <LandingClosingCta
    title="Ready to try the best mileage allowance management tool?"
    text="Our team is at your disposal to help you roll out izika in your organization."
    trackingContext="page_collectivites"
    class="bg-soft-neutral"
  >
    <div class="mt-4 flex items-start gap-2">
      <img width="50" src="/assets/markets/uk/brand/emblem-origin.png" alt="" loading="lazy" />
      <p class="flex-1">
        Application made in France,<br />
        Ultra-efficient, non-outsourced support!
      </p>
    </div>
  </LandingClosingCta>
</StandardLayout>
