---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/LandingHero.astro';
import LandingDeviceCollage from '../../components/LandingDeviceCollage.astro';
import LandingIconHighlights from '../../components/LandingIconHighlights.astro';
import LandingChecklistSection from '../../components/LandingChecklistSection.astro';
import LandingScreenCarousel from '../../components/LandingScreenCarousel.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import LandingClosingCta from '../../components/LandingClosingCta.astro';

const locale = 'fr';
const trackingContext = 'page_solo';

const highlights = [
  {
    icon: '/assets/landing-pages/team/icon_cal-to-rdv.png',
    text: 'Import des rendez-vous depuis votre agenda',
  },
  {
    icon: '/assets/landing-pages/icon_km-auto.png',
    text: 'Calcul automatique des distances',
  },
  {
    icon: '/assets/landing-pages/team/icon_report-conformity.png',
    text: 'Relevés conformes aux normes fiscales',
  },
  {
    icon: '/assets/landing-pages/team/icon_security.png',
    text: 'Sécurité, confidentialité<br /> créé et hébergé en France',
  },
];

const simplifyItems = [
  'Calcul instantané des distances et des indemnités kilométriques de chaque trajet',
  'Synchronisé avec les agendas en ligne (Outlook, Google...)',
  "Possibilité d'attacher des justificatifs, facturettes, rapports de visites",
  'Éditez en un clic votre relevé de frais kilométriques prêt à être transmis à votre comptable ou à inclure dans votre bilan.',
];

const simplifyScreens = [
  {
    src: '/assets/landing-pages/team/illu_rdv-etoiles.png',
    alt: 'Configuration des déplacements en étoile ou en tournée',
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/team/illu_justificatifs.png',
    alt: 'association des justificatifs aux rendez-vous',
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/screens/rapport-comptable.png',
    alt: 'éditez votre rapport comptable en 1 clic',
    width: 1078,
    height: 790,
  },
];

const adaptItems = [
  'Créez vos adresses favorites (domicile, bureau...) pour accélérer la saisie',
  'Choisissez votre mode de déplacement par défaut (en étoile ou en tournée)',
  'Ajoutez vos différents véhicules (izika gère aussi les véhicules électriques !)',
  'Déclarez vos provisions mensuelles, izika calcule le reste à charge à la fin de votre période fiscale',
];

const adaptScreens = [
  {
    src: '/assets/landing-pages/screens/parametres-adresses.png',
    alt: 'Listez vos adresses principales',
    width: 1644,
    height: 1204,
  },
  {
    src: '/assets/landing-pages/screens/parametres_mode-deplacement.png',
    alt: 'Configurez votre mode de déplacement par défaut',
    width: 1640,
    height: 1208,
  },
  {
    src: '/assets/landing-pages/screens/parametres-vehicules.png',
    alt: 'Listez vos différents véhicules',
    width: 1642,
    height: 1200,
  },
  {
    src: '/assets/landing-pages/screens/provisions.png',
    alt: 'Enregistrez vos provisions mensuelles',
    width: 1076,
    height: 792,
  },
];

const complianceItems = [
  "Conformité avec les règles fiscales. Relevés d'IK approuvés par les experts-comptables",
  'Cartographie ultra fiable pour un calcul des distances précis et sans erreurs',
  'Respect de la RGPD, clés de chiffrement avancées pour la confidentialité et la sécurité, souveraineté des données',
  "Support en France, à l'écoute et réactif",
];
---

<LandingLayout
  locale={locale}
  title="Gestion automatique des indemnités kilométriques"
  description="izika est la solution n°1 en Europe de calcul d'indemnités kilométriques pour les indépendants"
  routeKey="solo"
  footerBackground="gradient"
>
  <!-- Hero Section -->
  <LandingHero
    titlePrefix="Gestion des IK pour les"
    words={['indépendants', 'entrepreneurs']}
    ctaEventId="cta_header"
    ctaLabel="Tester gratuitement izika"
    trackingContext={trackingContext}
  >
    <p slot="lead">
      Votre temps est précieux, obtenez vos indemnités kilométriques en 10 min sans maux de tête.
    </p>

    <LandingDeviceCollage
      slot="media"
      desktopSrc="/assets/landing-pages/team/screen-next-rdv.jpg"
      desktopAlt="izika sur ordinateur de bureau"
      desktopWidth={1618}
      desktopHeight={1010}
      tabletSrc="/assets/landing-pages/screens/parametres.png"
      tabletAlt="paramétrez izika pour accélérer le traitement de vos IK"
      tabletWidth={1642}
      tabletHeight={1202}
    />
  </LandingHero>

  <!-- Highlights row (old "Clients" section) -->
  <LandingIconHighlights items={highlights} />

  <!-- Features Section 1 -->
  <LandingChecklistSection
    eyebrow="Vos relevés d'IK en 2 min."
    title="Simplifiez le calcul de vos IK"
    items={simplifyItems}
    class="bg-soft-neutral"
  >
    <LandingScreenCarousel images={simplifyScreens} />
  </LandingChecklistSection>

  <!-- Features Section 2 -->
  <LandingChecklistSection
    eyebrow="Pour aller encore plus vite"
    title="Izika s'adapte à vos usages"
    items={adaptItems}
    reverse
  >
    <LandingScreenCarousel images={adaptScreens} />
  </LandingChecklistSection>

  <!-- Features Section 3 -->
  <LandingChecklistSection
    eyebrow="Conformité, sécurité, fiabilité"
    title="Conformité avec les règles fiscales. Relevés d'IK approuvés par les experts comptables"
    items={complianceItems}
    class="bg-soft-primary pb-16 lg:pb-0"
  >
    <figure class="mx-auto w-4/5">
      <img
        class="h-auto w-full"
        src="/assets/img/illustrations/expert-comptable-large.png"
        alt="Image Description"
        width="1203"
        height="1349"
        loading="lazy"
      />
    </figure>
  </LandingChecklistSection>

  <!-- Testimonials Section -->
  <section class="mx-auto max-w-6xl px-4 pt-16 pb-32">
    <div class="grid gap-6 md:grid-cols-2">
      <TestimonialCard author="Eleonore" role="">
        Cela fait un peu plus d'un an que j'utilise Izika et j'ai mené des recherches avant de
        souscrire à cette appli : elle était la seule qui me permettait de calculer les distances
        entre plusieurs points de rendez-vous notés sur mon agenda électronique.
      </TestimonialCard>

      <TestimonialCard author="Arnaud Philippe" role="">
        Interface pratique en lien avec google Agenda, édition rapide du tableau d'IK, gain de
        temps important. Bonne ergonomie de l'application.
      </TestimonialCard>

      <TestimonialCard author="Christian Dumay" role="">
        J'utilise IZIKA depuis 3 ans et le conseille autour de moi. Le temps que je gagne chaque
        mois est utilisé pour d'autres activités ! Tout est simple et ergonomique. La rigueur des
        rendez-vous au quotidien, une fois mécanisée, ne compte plus. Merci
      </TestimonialCard>

      <TestimonialCard author="Frédéric Bessede" role="">
        Ma comptabilité kilométrique de l'année en 15 minutes grand max, avec juste un peu de
        rigueur au fil de mon agenda gmail pour indiquer mes lieux de rdvs (ce qui est la moindre
        des choses), vraiment nickel (...)
      </TestimonialCard>
    </div>
  </section>

  <LandingClosingCta
    title="Voulez-vous tester le meilleur outil de calcul d'IK ?"
    text="Izika est gratuit jusqu'à 10 trajets par mois ! Essayez toutes les fonctionnalités sans engagement."
    ctaLabel="Tester gratuitement izika"
    trackingContext="page_solo"
    class="bg-[#f4f1eb]"
  />
</LandingLayout>
