---
import StandardLayout from '../../layouts/StandardLayout.astro';
import LegalShell from '../../components/LegalShell.astro';
import TermsBodyFr from '../../components/legal/TermsBodyFr.astro';
import { termsArticleTitlesFr } from '../../data/legal-terms.fr';

const toc = termsArticleTitlesFr.map((title, i) => ({
  href: `#article-${i + 1}`,
  label: `${i + 1}. ${title}`,
}));
---

<StandardLayout market="fr" routeKey="terms" title="Conditions Générales de Vente">
  <LegalShell market="fr" title="Conditions Générales de Vente" navTitle="Les articles" toc={toc}>
    <TermsBodyFr />
  </LegalShell>
</StandardLayout>
