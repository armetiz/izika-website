---
import LandingLayout from '../../layouts/LandingLayout.astro';
import TeamLanding from '../../components/TeamLanding.astro';
import LandingClosingCta from '../../components/LandingClosingCta.astro';
---

<LandingLayout
  locale="fr"
  title="Gestion des IK pour les collectivités"
  description="Simplifiez le calcul des IK pour vos collaborateurs"
  routeKey="teamCollectivites"
  footerBackground="soft"
>
  <TeamLanding audience="collectivités" trackingContext="page_collectivites" />

  <LandingClosingCta
    title="Prêt à tester le meilleur outil de gestion d'IK ?"
    text="Notre équipe est à votre disposition pour vous accompagner dans la mise en place d'izika dans votre structure."
    trackingContext="page_collectivites"
    class="bg-soft-neutral"
  >
    <div class="mt-4 flex items-start gap-2">
      <img width="50" src="/assets/landing-pages/team/cocorico.png" alt="" loading="lazy" />
      <p class="flex-1">
        Application made in France,<br />
        Support ultra-efficace en français et non sous-traité&nbsp;!
      </p>
    </div>
  </LandingClosingCta>
</LandingLayout>
