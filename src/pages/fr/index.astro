---
import LandingLayout from '../../layouts/LandingLayout.astro';
import Hero from '../../components/Hero.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import LogoCloud from '../../components/LogoCloud.astro';
import TrackedLink from '../../components/TrackedLink.astro';
import { webApplicationSchema } from '../../seo/schema';
import { getMarket } from '../../i18n';
import { reviews } from '../../data/reviews';
import { btnPill, btnPrimarySm } from '../../lib/cta';
import { localizedPath } from '../../i18n';

const market = 'fr';
// Page du marché fr : le bloc Trustpilot existe forcément pour ce marché.
const trustpilot = getMarket('fr').trustpilot!;
const trackingContext = 'page_home';

const calendarLogos = [
  { src: '/assets/landing-pages/google-icon.svg', alt: "Import d'IK depuis Google Agenda" },
  { src: '/assets/landing-pages/icloud-icon.svg', alt: "Import d'IK depuis iCloud" },
  { src: '/assets/landing-pages/outlook-icon.svg', alt: "Import d'IK depuis Microsoft Outlook" },
  { src: '/assets/landing-pages/office365-icon.png', alt: "Import d'IK depuis Microsoft Office 365" },
  { src: '/assets/landing-pages/ics-icon.svg', alt: "Import d'IK depuis fichier ICS" },
  { src: '/assets/landing-pages/dolibarr-icon.png', alt: "Import d'IK depuis Dolibarr" },
];

const teamBenefits = [
  'Toutes les fonctionnalités de izika Solo pour vos collaborateurs',
  'Cartographie ultra fiable pour un calcul des distances précis et sans erreurs',
  "Centralisation des demandes d'IK",
  "Rationalisation des flux d'approbation",
  "Gestion d'équipes et de dossiers",
  'Exports personnalisés',
];

interface PricingPlan {
  name: string;
  nameSuffix?: string;
  price: string;
  priceSuffix?: string;
  bigPrice?: boolean;
  featured?: boolean;
  features: string[];
  /** Team card: "+" separator rendered after the first feature. */
  plusAfterFirst?: boolean;
  eventId: string;
  ctaLabel: string;
}

const pricingPlans: PricingPlan[] = [
  {
    name: 'Solo',
    price: 'Gratuit',
    features: [
      '10 trajets/mois',
      '1 Utilisateur',
      "Gestion d'adresses et de véhicules favoris",
      "Connexion à tous les types d'agenda",
      "Gestion des provisions mensuelles d'IK",
      "Rapports d'IK limité à 10 déplacements / mois",
    ],
    eventId: 'cta_section_pricing_free',
    ctaLabel: 'Tester gratuitement',
  },
  {
    name: 'Solo',
    nameSuffix: '∞',
    price: '99 €',
    priceSuffix: '/ an',
    bigPrice: true,
    featured: true,
    features: [
      'Nombre illimité de trajets',
      '1 Utilisateur',
      "Gestion d'adresses et de véhicules favoris",
      "Connexion à tous les types d'agenda",
      "Gestion des provisions mensuelles d'IK",
      "Rapports d'IK complet",
    ],
    eventId: 'cta_section_pricing_solo',
    ctaLabel: 'Tester gratuitement',
  },
  {
    name: 'Team',
    price: 'Sur mesure',
    features: [
      'Fonctionnalités de Solo',
      'Multi utilisateurs',
      "Gestion des utilisateurs (création d'équipe, définition de superviseur/manageur)",
      "Flux d'approbation intelligents des demandes d'IK",
      'Gestion analytique des RDV',
      'Pièces jointes associées aux RDV',
      'Exports complets personnalisés',
    ],
    plusAfterFirst: true,
    eventId: 'cta_section_pricing_team',
    ctaLabel: 'Tester gratuitement pendant 2 mois',
  },
];
---

<LandingLayout
  market={market}
  title="Gestion automatique des indemnités kilométriques"
  description="izika est l'application n°1 en Europe de gestion des indemnités kilométriques pour les indépendants et les équipes"
  routeKey="home"
  schemaNodes={[webApplicationSchema(getMarket('fr'))]}
>
  <!-- Hero Section -->
  <Hero
    title="Vos IK en un temps record"
    lead="Votre temps est précieux, obtenez vos indemnités kilométriques en 10 min sans maux de tête."
    ctaEventId="cta_header"
    ctaLabel="Tester gratuitement izika"
    trackingContext={trackingContext}
  >
    <button
      slot="secondary"
      type="button"
      id="video-demo-btn"
      class="btn-3d inline-flex items-center gap-2 rounded-full px-4 py-3 font-bold"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-2 14.5v-9l7 4.5-7 4.5Z"></path>
      </svg>
      Démo vidéo
    </button>

    <div slot="media" class="relative hidden lg:block">
      <img
        class="w-full rounded-xl border border-beige-line shadow-card"
        src="/assets/landing-pages/team/screen-next-rdv.jpg"
        alt="izika sur ordinateur de bureau"
        width="1618"
        height="1010"
      />
      <img
        class="absolute -top-10 -left-6 w-52 -rotate-3 rounded-card border-4 border-white shadow-card"
        src="/assets/landing-pages/header-screen-ipad-horizontal.jpg"
        alt="izika sur tablette"
        width="1618"
        height="1010"
      />
      <img
        class="absolute -bottom-10 -left-2 w-32 rotate-2 rounded-card border-4 border-white shadow-card"
        src="/assets/landing-pages/header-screen-ipad.jpg"
        alt="izika sur ipad"
        width="533"
        height="711"
      />
      <img
        class="absolute -right-4 -bottom-8 w-24 rounded-2xl border-4 border-white shadow-card"
        src="/assets/landing-pages/header-screen-iphone-x.jpg"
        alt="izika sur mobile"
        width="407"
        height="867"
      />
    </div>
  </Hero>

  <!-- Video demo dialog (click-to-load YouTube embed) -->
  <dialog
    id="video-demo-dialog"
    class="m-auto w-[min(56rem,92vw)] rounded-lg bg-black p-0 backdrop:bg-black/70"
  >
    <div class="relative">
      <button
        type="button"
        id="video-demo-close"
        class="absolute top-2 right-2 z-10 rounded-full bg-white/90 px-3 py-1 font-bold"
        aria-label="Fermer la vidéo"
      >
        ✕
      </button>
      <div
        id="video-demo-frame"
        class="aspect-video w-full"
        data-src="https://www.youtube.com/embed/9qOYbd08_W4?autoplay=1"
      >
      </div>
    </div>
  </dialog>

  <!-- Features Section -->
  <section id="featuresSection" class="mx-auto max-w-6xl px-4">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <FeatureCard
        icon="/assets/landing-pages/icon_cal-to-rdv.png"
        iconAlt="Import des RDV depuis l'agenda"
        title="Saisie automatique"
      >
        izika importe automatiquement vos rendez-vous depuis votre agenda électronique.
      </FeatureCard>

      <FeatureCard
        icon="/assets/landing-pages/icon_km-auto.png"
        iconAlt="Calculs des distances automatiques"
        title="Calculs automatiques"
      >
        izika calcule automatiquement les distances et le montant de vos IK sans quitter
        l'application.
      </FeatureCard>

      <FeatureCard
        icon="/assets/landing-pages/icon_report-conformity.png"
        iconAlt="Conforme aux règles fiscales"
        title="Conformité fiscale"
      >
        izika est approuvé et validé par les experts-comptables et l'administration.
      </FeatureCard>

      <FeatureCard
        icon="/assets/landing-pages/icon_team.png"
        iconAlt="Gestion des flottes de véhicules"
        title="Gestion de flottes"
        badge="team"
      >
        izika team est le seul outil de gestion des flux d'approbation d'IK pour les entreprises.
      </FeatureCard>
    </div>

    <div class="my-8 text-center">
      <a
        class={btnPrimarySm}
        href={localizedPath('features', market)}
        target="_blank"
        rel="noopener"
      >
        Découvrir toutes les fonctionnalités <span aria-hidden="true">›</span>
      </a>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="my-8 rounded-card bg-soft-neutral py-8 lg:mt-16 lg:pt-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <h2 class="text-3xl font-bold">
          Plus de 3500 indépendants et entreprises ont choisi izika.
        </h2>
        <a
          class="mt-4 inline-flex items-center justify-center gap-2 text-[2.5rem] font-bold"
          href={trustpilot.url}
          rel="nofollow"
        >
          {reviews.ratingValue}
          <span class="text-primary" aria-hidden="true">★</span>
          <span class="sr-only">sur 5 sur Trustpilot</span>
        </a>
      </div>

      <div
        class="rounded-card bg-cover bg-center p-4 sm:p-8 lg:p-12"
        style="background-image: url('/assets/img/mockup-liste-rdv.jpg');"
      >
        <div class="grid gap-6 md:grid-cols-3">
          <TestimonialCard author="Pierre-Louis" role="Réparateur téléphones & informatique">
            Vraiment top, se synchronise avec tous les agendas. Le service rendu m’a fait gagner des
            heures voire des semaines de calculs de frais kilométrique pour les déplacements chez
            mes clients. Service client très rapide et réactif.
          </TestimonialCard>

          <TestimonialCard author="Martial" role="Agent immobilier">
            Une simplicité exceptionnelle !<br />
            Jamais je n'ai eu autant de plaisir à faire mes frais kilométriques ! Avant, c'était une
            vraie galère... avec IZIKA c'est devenu un jeu d'enfant !
          </TestimonialCard>

          <TestimonialCard author="Romain" role="Agent commercial">
            Très satisfait de l'utilisation. Vraiment pratique et très bien pensé. Le service client
            est top, très réactif et de bon conseil utilisateur.
            <br />
            Je recommande les yeux fermés.
          </TestimonialCard>
        </div>
      </div>

      <div class="mt-10 text-center">
        <!-- TrustBox widget - Review Collector -->
        <div
          class="trustpilot-widget"
          data-locale={trustpilot.widgetLocale}
          data-template-id="56278e9abfbbba0bdcd568bc"
          data-businessunit-id="5950be670000ff0005a55a73"
          data-style-height="52px"
          data-style-width="100%"
        >
          <a href={trustpilot.url} target="_blank" rel="noopener">Trustpilot</a>
        </div>
        <!-- End TrustBox widget -->
        <div class="mt-4">
          <a
            class={btnPrimarySm}
            href={trustpilot.url}
            target="_blank"
            rel="noopener"
          >
            Lire les avis <span aria-hidden="true">›</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Works Section -->
  <section id="features" class="mx-auto max-w-6xl px-4 py-8 lg:py-16">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <h2 class="text-3xl font-bold">
        Comment izika calcule les indemnités kilométriques pour vous ?
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-card bg-soft-primary p-6 lg:p-10">
        <img
          class="mb-8 h-auto w-full"
          src="/assets/landing-pages/how-it-works-calendar-import.png"
          alt="izika import des rdv depuis le calendrier"
          width="2000"
          height="1334"
          loading="lazy"
        />
        <h3 class="flex items-start justify-between gap-3 text-[1.3125rem] font-bold">
          Importez et gérez vos RDV
          <span
            class="mt-1 inline-block shrink-0 rounded-full bg-primary-hover px-2 py-0.5 text-xs font-bold text-white"
          >
            automatique
          </span>
        </h3>
        <p class="mt-1 mb-3 text-sm italic">En quelques clics, un jeu d'enfant !</p>
        <p>
          Connectez izika à votre agenda, et vos rendez-vous apparaissent automatiquement sur
          l'écran de gestion des déplacements. Les distances sont déjà calculées depuis les adresses
          renseignées dans votre agenda ! 👌
        </p>

        <LogoCloud
          class="mt-6"
          logos={calendarLogos}
          note="+ d'autres"
          noteTitle="Toutes les applications comptabiles avec CalDAV"
        />
      </div>

      <div class="rounded-card bg-soft-neutral p-6 lg:p-10">
        <img
          class="mb-8 h-auto w-full"
          src="/assets/landing-pages/how-it-works-mensual-provisions.png"
          alt="izika provisions ik mensuelles"
          width="2000"
          height="1299"
          loading="lazy"
        />
        <h3 class="text-[1.3125rem] font-bold">Vous déclarez des IK mensuelles ?</h3>
        <p class="mt-1 mb-3 text-sm italic">Aucun problème, c'est prévu.</p>
        <p>
          izika calcule pour vous des provisions d'indemnités kilométriques mensuelles indicatives
          tout au long de la période fiscale. Reportez le montant réel des provisions que vous
          percevez mois par mois et izika en tiendra compte automatiquement lors de l'édition du
          relevé général en fin de période fiscale.
        </p>
      </div>

      <div class="rounded-card bg-soft-neutral p-6 lg:p-10">
        <img
          class="mb-8 h-auto w-full"
          src="/assets/landing-pages/how-it-works-mileage-allowances-export.png"
          alt="izika rapport d'indemnités kilométriques"
          width="2000"
          height="1764"
          loading="lazy"
        />
        <h3 class="text-[1.3125rem] font-bold">Éditez votre relevé d'IK</h3>
        <p class="mt-1 mb-3 text-sm italic">C'est déjà fini 😮 ? Oui oui.</p>
        <p>
          Une fois vos RDV importés et vos déplacements affinés, éditez votre relevé de frais
          kilométriques prêt à être transmis à votre comptable ou à inclure dans votre bilan. Izika
          liste chaque déplacement professionnel avec toutes les informations obligatoires
          normalisées dans le respect des règles comptables et fiscales.
        </p>
      </div>

      <div class="rounded-card bg-beige-dark p-6 lg:p-10">
        <img
          class="mb-8 h-auto w-full"
          src="/assets/landing-pages/how-it-works-parameters.png"
          alt="izika paramètres"
          width="2000"
          height="1454"
          loading="lazy"
        />
        <h3 class="text-[1.3125rem] font-bold">Besoin d'aller encore plus vite ? 🚀</h3>
        <p class="mt-1 mb-3 text-sm italic">C'est possible, izika s'apdate à vos habitudes.</p>
        <p>
          Vous pouvez affiner vos paramètres et optimiser les traitements automatiques de
          l'application :<br />
          Configurez vos adresses de départ et de retour habituelles, votre véhicule principal, vos
          habitudes de déplacements : en tournée ou en étoile...
        </p>
      </div>
    </div>

    <div class="mt-12 text-center">
      <TrackedLink
        eventId="cta_middle"
        trackingContext={trackingContext}
        class="btn-3d inline-block min-w-40 rounded-card bg-primary px-4 py-3 text-center font-bold text-white hover:bg-primary-hover sm:px-8"
      >
        Tester izika
      </TrackedLink>
    </div>
  </section>

  <!-- CTA Section (izika Team) -->
  <section class="overflow-hidden bg-beige-light pt-16 lg:pt-8">
    <div class="mx-auto max-w-6xl px-4 pt-16 pb-32">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-2 text-sm font-bold tracking-wide uppercase">
            Entreprises, collectivités, associations
          </p>
          <h2 class="mb-6 text-3xl font-bold">
            Vous gérez les IK de vos collaborateurs ? izika Team, c'est :
          </h2>

          <ul class="space-y-3">
            {
              teamBenefits.map((benefit) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white"
                    aria-hidden="true"
                  >
                    ✓
                  </span>
                  <p>{benefit}</p>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a
              class={btnPill}
              href={localizedPath('team', market)}
            >
              En savoir plus sur izika Team <span aria-hidden="true">›</span>
            </a>
            <TrackedLink
              eventId="cta_section_team"
              trackingContext={trackingContext}
              class="btn-3d inline-block rounded-full px-4 py-3 font-bold"
            >
              Tester gratuitement pendant 2 mois <span aria-hidden="true">›</span>
            </TrackedLink>
          </div>
        </div>

        <div>
          <img
            class="h-auto w-full rounded-card shadow-card"
            src="/assets/landing-pages/team/illu_liste-demandes.png"
            alt="izika team"
            width="920"
            height="719"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricingSection" class="mx-auto max-w-6xl overflow-hidden px-4 py-16 lg:py-32">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <h2 class="text-[2.5rem] font-bold">Tarification</h2>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        pricingPlans.map((plan) => (
          <div class="relative">
            {plan.featured && (
              <figure
                class="absolute -top-6 -right-6 -z-10 w-32"
                aria-hidden="true"
              >
                <svg preserveAspectRatio="none" viewBox="0 0 260 260" xmlns="http://www.w3.org/2000/svg">
                  <circle class="fill-primary-hover" cx="130" cy="130" r="130" />
                </svg>
              </figure>
            )}
            <div
              class:list={[
                'flex h-full flex-col rounded-card bg-white p-6',
                plan.featured && 'shadow-card',
              ]}
            >
              <div class="mb-6 text-center">
                <p class="text-[1.3125rem] font-bold">
                  {plan.name}
                  {plan.nameSuffix && <span aria-label="illimité">{plan.nameSuffix}</span>}
                </p>
                <p class="mt-3">
                  <span
                    class:list={[
                      'font-bold',
                      plan.bigPrice ? 'text-4xl' : 'text-sm',
                    ]}
                  >
                    {plan.price}
                  </span>
                  {plan.priceSuffix && <span class="text-sm">{plan.priceSuffix}</span>}
                </p>
              </div>

              <ul class="grow space-y-3 text-sm text-muted">
                {plan.features.map((feature, index) => (
                  <>
                    <li class="flex items-start gap-2">
                      <svg
                        class="mt-0.5 h-4 w-4 shrink-0 text-success"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.6-4.3-4.3 1.7-1.7 2.6 2.6 5.8-5.8 1.7 1.7-7.5 7.5Z" />
                      </svg>
                      {feature}
                    </li>
                    {plan.plusAfterFirst && index === 0 && (
                      <li class="text-center text-lg font-bold" aria-hidden="true">
                        +
                      </li>
                    )}
                  </>
                ))}
              </ul>

              <div class="mt-6">
                <TrackedLink
                  eventId={plan.eventId}
                  trackingContext={trackingContext}
                  class:list={[
                    'btn-3d block rounded-card px-4 py-3 text-center font-bold',
                    plan.featured
                      ? 'bg-primary text-white hover:bg-primary-hover'
                      : 'border border-primary text-primary hover:bg-primary hover:text-white',
                  ]}
                >
                  {plan.ctaLabel}
                </TrackedLink>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</LandingLayout>

<script>
  const videoBtn = document.getElementById('video-demo-btn');
  const videoDialog = document.getElementById('video-demo-dialog') as HTMLDialogElement | null;
  const videoFrame = document.getElementById('video-demo-frame');

  videoBtn?.addEventListener('click', () => {
    if (!videoDialog || !videoFrame) return;
    if (!videoFrame.querySelector('iframe')) {
      const iframe = document.createElement('iframe');
      iframe.src = videoFrame.dataset.src ?? '';
      iframe.title = 'Frais professionnels : gestion des indemnités kilométriques';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'h-full w-full';
      videoFrame.append(iframe);
    }
    videoDialog.showModal();
  });

  // Stop playback when the dialog closes (Esc or the close button).
  videoDialog?.addEventListener('close', () => {
    videoFrame?.querySelector('iframe')?.remove();
  });

  document.getElementById('video-demo-close')?.addEventListener('click', () => {
    videoDialog?.close();
  });
</script>
