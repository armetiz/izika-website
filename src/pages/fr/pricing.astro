---
import StandardLayout from '../../layouts/StandardLayout.astro';
import PricingPage from '../../components/templates/PricingPage.astro';
import { pricingPageFr } from '../../data/pricing-page.fr';
import { featureCardsFr } from '../../data/feature-cards.fr';
import { webApplicationSchema } from '../../seo/schema';
import { getMarket } from '../../i18n';
---

<StandardLayout
  market="fr"
  routeKey="pricing"
  title="Nos offres et tarifs"
  description="Simplifiez vos frais kilométriques avec le logiciel le plus performant du marché."
  schemaNodes={[webApplicationSchema(getMarket('fr'))]}
>
  <PricingPage market="fr" copy={pricingPageFr} featureCards={featureCardsFr} />
</StandardLayout>
