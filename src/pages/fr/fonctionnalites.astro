---
import StandardLayout from '../../layouts/StandardLayout.astro';
import TrackedLink from '../../components/TrackedLink.astro';
import { localizedPath } from '../../i18n';

// Ported from templates/content/features.html.twig
const trackingContext = 'page_features';

const iconBlocks = [
  {
    icon: '/assets/landing-pages/icon_km-auto.png',
    alt: 'izika import des rdv depuis le calendrier',
    title: 'Génération automatique des déplacements',
    text: 'izika génère votre liste de déplacements à partir des rendez-vous de votre agenda.',
  },
  {
    icon: '/assets/landing-pages/icon_cal-to-rdv.png',
    alt: 'SVG',
    title: 'Connexion avec votre agenda en ligne',
    text: 'Connectez votre agenda en ligne préféré : Google Agenda, Outlook, Office360, iCloud, lien .ics…',
  },
  {
    icon: '/assets/landing-pages/icon_bareme-personnalise.png',
    alt: 'configurez votre mode de déplacement par défaut',
    title: 'Barèmes kilométriques',
    text: 'Vous pouvez choisir d’utiliser les barêmes officiels ou bien de créer votre propre barême personnalisé.',
  },
  {
    icon: '/assets/landing-pages/icon_report-conformity.png',
    alt: 'SVG',
    title: 'Export conforme aux normes fiscales en vigueur',
    text: 'Vous récupérez un export mensuel et/ou annuel complet, lisible, fiable et conforme aux normes fiscales.',
  },
] as const;
---

<StandardLayout
  locale="fr"
  routeKey="features"
  title="Fonctionnalités"
  description="Des fonctionnalités fiables pour vous faire gagner toujours plus de temps sur vos IK"
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-transparent to-soft-primary pt-24 pb-16 lg:pt-32">
    <div class="mx-auto max-w-6xl px-4 text-center">
      <div class="mx-auto max-w-3xl">
        <h1 class="text-[2.5rem] font-bold">Fonctionnalités</h1>
        <h2 class="mt-4 text-3xl font-bold">
          Des fonctionnalités fiables pour vous faire gagner toujours plus de temps sur vos IK
        </h2>
      </div>
      <div class="mt-8">
        <TrackedLink
          eventId="cta_header"
          trackingContext={trackingContext}
          class="btn-3d inline-block min-w-40 rounded-[0.3125rem] bg-primary px-4 py-3 text-base font-bold text-white sm:px-12"
        >
          Essayez gratuitement
        </TrackedLink>
      </div>
    </div>
  </section>

  <!-- Icon blocks -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid gap-8 md:grid-cols-2 lg:gap-x-16">
      {iconBlocks.map((block) => (
        <div class="flex items-start gap-4">
          <figure class="w-full max-w-32 shrink-0">
            <img class="h-auto max-w-full" src={block.icon} alt={block.alt} loading="lazy" />
          </figure>
          <div>
            <h4 class="text-lg font-bold">{block.title}</h4>
            <p class="mt-2">{block.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Cards -->
  <section class="bg-soft-primary py-16">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        <div class="flex h-full flex-col overflow-hidden rounded-[0.3125rem] bg-white shadow-card">
          <img class="w-full" src="/assets/img/fonctionnalites/fonctionnalites-vehicules.jpg" alt="Image Description" loading="lazy" />
          <div class="flex-1 p-6">
            <h4 class="text-lg font-bold">Gestion multi-véhicules</h4>
            <p class="mt-3">
              🚘 Configurez vos différents véhicules et leurs puissances fiscales, et définissez votre véhicule par défaut.
            </p>
            <p class="mt-3 mb-0">
              ⚡ Prise en compte du barême propre aux <strong>véhicules électriques</strong>.
            </p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-[0.3125rem] bg-white shadow-card">
          <img class="w-full" src="/assets/img/fonctionnalites/fonctionnalites-adresses.jpg" alt="Image Description" loading="lazy" />
          <div class="flex-1 p-6">
            <h4 class="text-lg font-bold">Adresses favorites</h4>
            <p class="mt-3">
              🏢 Saisissez vos adresses favorites pour les définir automatiquement comme points de départ et d'arrivée de vos déplacements réguliers.
            </p>
          </div>
        </div>

        <div class="flex h-full flex-col overflow-hidden rounded-[0.3125rem] bg-white shadow-card">
          <img class="w-full" src="/assets/img/fonctionnalites/fonctionnalites-mode-deplacement.jpg" alt="Image Description" loading="lazy" />
          <div class="flex-1 p-6">
            <h4 class="text-lg font-bold">Modes de déplacement</h4>
            <p class="mt-3">Choisissez votre mode de déplacement par défaut :</p>
            <p class="mt-3 mb-0">
              ⏭️ En <strong>tournée</strong> si vous enchainez les rendez-vous les uns à la suite des autres<br />
              ✴️ En <strong>étoile</strong> si vous revenez à votre point de départ entre chaque rendez-vous.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team block -->
  <section class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex max-w-xl items-start gap-4">
      <figure class="w-full max-w-32 shrink-0">
        <img class="h-auto max-w-full" src="/assets/landing-pages/icon_team.png" alt="gestion multi vehicule et vehicule favori" loading="lazy" />
      </figure>
      <div>
        <h4 class="text-lg font-bold">Gestion de flottes</h4>
        <p class="mt-2">Gestion des flux d'approbation des demandes d'IK des salariés pour les entreprises</p>
        <a class="btn-3d mt-2 inline-block font-bold text-ink" href={localizedPath('team', 'fr')}>
          En savoir plus sur izika Team
          <span aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-5xl px-4 pb-16">
    <div class="rounded-[0.3125rem] bg-white p-8 shadow-card">
      <div class="flex flex-col items-center gap-6 text-center md:flex-row md:justify-between md:text-left">
        <h3 class="text-lg font-bold md:ml-auto md:max-w-md">
          Prêt à tester ? Essayez gratuitement et sans obligation d'achat
        </h3>
        <div class="md:text-right">
          <TrackedLink
            eventId="cta_block_cta"
            trackingContext={trackingContext}
            class="btn-3d inline-block rounded-[0.3125rem] bg-primary px-4 py-3 text-base font-bold text-white"
          >
            Créez votre compte
          </TrackedLink>
        </div>
      </div>
    </div>
  </section>
</StandardLayout>
