---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingHero from '../../components/LandingHero.astro';
import LandingDeviceCollage from '../../components/LandingDeviceCollage.astro';
import LandingIconHighlights from '../../components/LandingIconHighlights.astro';
import LandingChecklistSection from '../../components/LandingChecklistSection.astro';
import LandingScreenCarousel from '../../components/LandingScreenCarousel.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';
import LandingClosingCta from '../../components/LandingClosingCta.astro';

const locale = 'fr';
const trackingContext = 'page_team';

const heroLeadItems = [
  "Calcul automatique des IK depuis l'agenda des collaborateurs terrain",
  "Des flux d'approbation transparents et efficaces pour les gestionnaires",
  'Des documents comptables fiables et normalisés',
];

const highlights = [
  {
    icon: '/assets/landing-pages/team/icon_cal-to-rdv.png',
    text: 'Génération en ligne de relevés de déplacements',
  },
  {
    icon: '/assets/landing-pages/team/icon_approval.png',
    text: "Flux d'approbation des demandes d'IK",
  },
  {
    icon: '/assets/landing-pages/team/icon_teams-and-folders.png',
    text: 'Ventilation des IK par équipe et par dossier',
  },
  {
    icon: '/assets/landing-pages/team/icon_report-conformity.png',
    text: 'Relevés conformes aux normes fiscales',
  },
  {
    icon: '/assets/landing-pages/team/icon_security.png',
    text: 'Sécurité, confidentialité<br /> créé et hébergé en France',
  },
];

const simplifyItems = [
  'Calcul instantané des distances et IK de chaque trajet',
  'Synchronisé avec les agendas en ligne (Outlook, Google...)',
  'Paramétrage des déplacements en tournée ou en étoile.',
  "Possibilité d'attacher des justificatifs, facturettes, rapports de visites",
];

const simplifyScreens = [
  {
    src: '/assets/landing-pages/team/illu_rdv-etoiles.png',
    alt: 'Configuration des déplacements en étoile ou en tournée',
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/team/illu_dossiers.png',
    alt: 'catégorisation des rendez-vous en dossiers',
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/team/illu_justificatifs.png',
    alt: 'association des justificatifs aux rendez-vous',
    width: 920,
    height: 719,
  },
];

const approvalItems = [
  'Organisation par équipe pour chaque gestionnaire',
  'Approbation et rejet en un clic, pointage des trajets à vérifier',
  'Consolidation analytique par collaborateur et par client ou dossier',
  "Conformité fiscale des relevés d'indemnités kilométriques",
];

const approvalScreens = [
  {
    src: '/assets/landing-pages/team/illu_liste-demandes.png',
    alt: "Liste des demandes d'indemnisation",
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/team/illu_approve.png',
    alt: 'approuver une demande',
    width: 920,
    height: 719,
  },
  {
    src: '/assets/landing-pages/team/illu_voir-itineraire.png',
    alt: "Voir l'itinéraire en détail",
    width: 920,
    height: 719,
  },
];

const complianceItems = [
  "Conformité avec les règles fiscales. Relevés d'IK approuvés par les experts-comptables",
  'Cartographie ultra fiable pour un calcul des distances précis et sans erreurs',
  'Respect de la RGPD, clés de chiffrement avancées pour la confidentialité et la sécurité, souveraineté des données',
  "Support en France, à l'écoute et réactif",
];
---

<LandingLayout
  locale={locale}
  title="Gestion des IK pour les entreprises et collectivité"
  description="Simplifiez le calcul des IK pour vos collaborateurs"
  routeKey="team"
>
  <!-- Hero Section -->
  <LandingHero
    titlePrefix="Gestion des IK pour les"
    words={['entreprises', 'collectivités', 'associations']}
    ctaEventId="cta_header"
    ctaLabel="Tester gratuitement izika"
    trackingContext={trackingContext}
  >
    <ul slot="lead" class="space-y-3">
      {
        heroLeadItems.map((item) => (
          <li class="flex items-start gap-3">
            <span
              class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-ink"
              aria-hidden="true"
            >
              ✓
            </span>
            <p>{item}</p>
          </li>
        ))
      }
    </ul>

    <LandingDeviceCollage
      slot="media"
      desktopSrc="/assets/landing-pages/team/screen-approve-demand.jpg"
      desktopAlt="izika sur ordinateur de bureau"
      desktopWidth={1618}
      desktopHeight={1010}
      tabletSrc="/assets/landing-pages/team/screen-next-rdv2.jpg"
      tabletAlt="configurer les rendez-vous en étoile"
      tabletWidth={1618}
      tabletHeight={1210}
    />
  </LandingHero>

  <!-- Highlights row (old "Clients" section) -->
  <LandingIconHighlights items={highlights} />

  <!-- Features Section 1 -->
  <LandingChecklistSection
    eyebrow="Vos relevés d'IK en 2 min."
    title="Simplifiez le calcul des IK pour vos collaborateurs"
    items={simplifyItems}
    class="bg-beige"
  >
    <LandingScreenCarousel images={simplifyScreens} />
  </LandingChecklistSection>

  <!-- Features Section 2 -->
  <LandingChecklistSection
    eyebrow="Centralisation et automatisation"
    title="Accélérez le traitement des demandes d'IK"
    items={approvalItems}
    reverse
  >
    <LandingScreenCarousel images={approvalScreens} />
  </LandingChecklistSection>

  <!-- Features Section 3 -->
  <LandingChecklistSection
    eyebrow="Conformité, sécurité, fiabilité"
    title="Conformité avec les règles fiscales. Relevés d'IK approuvés par les experts comptables"
    items={complianceItems}
    class="bg-soft-primary"
  >
    <figure class="mx-auto w-4/5">
      <img
        class="h-auto w-full"
        src="/assets/img/illustrations/expert-comptable-large.png"
        alt="Image Description"
        width="1203"
        height="1349"
        loading="lazy"
      />
    </figure>
  </LandingChecklistSection>

  <!-- Testimonials Section -->
  <section class="mx-auto max-w-6xl px-4 py-16 lg:py-24">
    <div class="grid gap-6 md:grid-cols-2">
      <TestimonialCard author="Olivier" role="Expert-comptable">
        Nous avons suggéré à izika d’inclure dans la version Team la gestion de la chaîne
        d’approbation des indemnités kilométriques depuis le conducteur jusqu’à la paie. Et le
        résultat dépasse nos espérances! Merci beaucoup.
      </TestimonialCard>

      <TestimonialCard author="Romain F" role="Dirigeant de groupement d’agences immobilières">
        J’aime beaucoup le fait de remplacer des déclarations sous Excel avec des kilométrages
        fantaisistes de la part de certains des salariés par un calcul effectué par un tiers sur la
        base des RDV de l’agenda Outlook des techniciens de maintenance (...)
      </TestimonialCard>

      <TestimonialCard author="France" role="Comptable (SARL de climatisation)">
        IZIKA gère les distances et les IK, mais aussi les pièces jointes comme les tickets de
        parking. Cela nous permet de tout centraliser du commercial à son manager puis à la
        comptabilité.
      </TestimonialCard>

      <TestimonialCard author="Mohed" role="président d’association">
        Je trouve que le système des approbations et refus des relevés d’IK des salariés est super
        bien pensé, mais on apprécie surtout de recevoir des données fiables de la part des
        commerciaux terrain.
      </TestimonialCard>
    </div>
  </section>

  <LandingClosingCta
    title="Prêt à tester le meilleur outil de gestion d'IK ?"
    text="Essayez gratuitement toutes les fonctionnalités de izika Team pour votre organisation."
    ctaLabel="Tester izika pendant 2 mois"
    trackingContext="page_team"
  />
</LandingLayout>
