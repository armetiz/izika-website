---
import StandardLayout from '../../layouts/StandardLayout.astro';
import PricingPage from '../../components/PricingPage.astro';
import { pricingPageChFr } from '../../data/pricing-page.ch-fr';
import { featureCardsChFr } from '../../data/feature-cards.ch-fr';
import { webApplicationSchema } from '../../seo/schema';
import { getMarket } from '../../i18n';
---

<StandardLayout
  market="ch-fr"
  routeKey="pricing"
  title="Nos offres et tarifs"
  description="izika Solo à CHF 149/an, izika Team à CHF 12/mois/utilisateur. Facturation en francs suisses, sans engagement."
  schemaNodes={[webApplicationSchema(getMarket('ch-fr'))]}
>
  <PricingPage market="ch-fr" copy={pricingPageChFr} featureCards={featureCardsChFr} />
</StandardLayout>
