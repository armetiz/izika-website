---
import StandardLayout from '../../layouts/StandardLayout.astro';
import TeamLanding from '../../components/TeamLanding.astro';
import LandingClosingCta from '../../components/LandingClosingCta.astro';
import { teamLandingChFr } from '../../data/team-landing.ch-fr';
---

<StandardLayout
  market="ch-fr"
  title="Gestion des frais kilométriques pour les entreprises"
  description="Centralisez les demandes de remboursement de frais kilométriques de vos collaborateurs, au taux de votre règlement de frais."
  routeKey="teamEntreprises"
  footerBackground="soft"
>
  <TeamLanding audience="entreprises" trackingContext="page_entreprises" copy={teamLandingChFr} />

  <LandingClosingCta
    title="Prêt à tester le meilleur outil de gestion des frais kilométriques ?"
    text="Notre équipe est à votre disposition pour vous accompagner dans la mise en place d'izika dans votre structure."
    trackingContext="page_entreprises"
    class="bg-soft-neutral"
  >
    {/*
      Pas de bloc « cocorico / made in France » ici, contrairement à /fr : en
      Suisse l'argument qui porte est la souveraineté des données, pas le
      pavillon de l'éditeur.
    */}
    <p class="mt-4">
      Support en français, direct et non sous-traité.<br />
      Hébergement européen, hors cloud américain.
    </p>
  </LandingClosingCta>
</StandardLayout>
