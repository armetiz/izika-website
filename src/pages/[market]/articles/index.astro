---
import { getCollection, type CollectionEntry } from 'astro:content';
import StandardLayout from '../../../layouts/StandardLayout.astro';
import GradientHero from '../../../components/GradientHero.astro';
import Card from '../../../components/Card.astro';
import { articlePath, getMarket, marketIds, routeSlug, t, type MarketId } from '../../../i18n';

export function getStaticPaths() {
  // A market has an articles hub iff routes.articles defines its slug — and
  // this file's directory pins the URL segment to "articles", so a market
  // wanting another segment needs its own route file.
  return marketIds
    .filter((market) => {
      const slug = routeSlug('articles', market);
      if (slug !== undefined && slug !== 'articles') {
        throw new Error(
          `routes.articles["${market}"] is "${slug}" but the [market]/articles/ directory pins the segment to "articles".`,
        );
      }
      return slug !== undefined;
    })
    .map((market) => ({ params: { market }, props: { market } }));
}

type Article = CollectionEntry<'articles'>;

const { market } = Astro.props as { market: MarketId };

// Successor of the old /pages index, now a real editorial hub.
const articles = (await getCollection('articles', ({ id }) => id.startsWith(`${market}/`))).filter(
  (a) => !a.data.robots?.includes('noindex'),
);

const slugOf = (a: Article) => a.id.split('/').slice(1).join('/');
const byDateDesc = (a: Article, b: Article) => b.data.date.valueOf() - a.data.date.valueOf();
const yearOf = (a: Article) => slugOf(a).match(/(\d{4})$/)?.[1] ?? '';

const baremes = articles
  .filter((a) => slugOf(a).startsWith('bareme-'))
  .sort((a, b) => yearOf(b).localeCompare(yearOf(a)));
const integrations = articles.filter((a) => slugOf(a).startsWith('integration-')).sort(byDateDesc);
const guides = articles
  .filter((a) => !slugOf(a).startsWith('bareme-') && !slugOf(a).startsWith('integration-'))
  .sort(byDateDesc);

const dateFormat = new Intl.DateTimeFormat(getMarket(market).numberLocale, { dateStyle: 'long' });
const hub = t(market).articlesHub;
---

<StandardLayout
  market={market}
  routeKey="articles"
  title={hub.metaTitle}
  description={hub.metaDescription}
>
  <GradientHero class="text-center">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-[2.5rem] font-bold">{hub.heading}</h1>
      <p class="mt-4 text-lg text-muted">{hub.lead}</p>
    </div>
  </GradientHero>

  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mx-auto max-w-5xl space-y-16">
      <section id="baremes">
        <h2 class="text-3xl font-bold">{hub.baremesTitle}</h2>
        <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
          {
            baremes.map((a) => (
              <a class="block h-full" href={articlePath(slugOf(a), market)}>
                <Card hover3d bodyClass="text-center">
                  <p class="text-3xl font-bold text-ink">{yearOf(a)}</p>
                  <p class="mt-1 text-sm">{hub.baremeCard}</p>
                </Card>
              </a>
            ))
          }
        </div>
      </section>

      {
        [
          { id: 'integrations', title: hub.integrationsTitle, items: integrations },
          { id: 'guides', title: hub.guidesTitle, items: guides },
        ].map(({ id, title, items }) => (
          <section id={id}>
            <h2 class="text-3xl font-bold">{title}</h2>
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((a) => (
                <a class="block h-full" href={articlePath(slugOf(a), market)}>
                  <Card hover3d>
                    <h3 class="text-lg font-bold">{a.data.title}</h3>
                    <p class="mt-2 line-clamp-3 text-sm">{a.data.description}</p>
                    <p class="mt-4 text-xs">{dateFormat.format(a.data.date)}</p>
                  </Card>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</StandardLayout>
