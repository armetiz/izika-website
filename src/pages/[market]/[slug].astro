---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { routes, splitContentId } from '../../i18n';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const reservedSlugs = new Set(
    Object.values(routes).flatMap((byMarket) =>
      Object.entries(byMarket).map(([market, slug]) => `${market}/${slug}`),
    ),
  );

  return articles.map((entry) => {
    // Orphan content directory (src/content/articles/<x>/ without a market)
    // fails the build inside splitContentId instead of publishing a ghost URL.
    const [market, slug] = splitContentId(entry.id);
    // An article slug shadowing an editorial route would produce a ghost page
    // (static routes win) — fail explicitly instead.
    if (reservedSlugs.has(entry.id)) {
      throw new Error(
        `Article "${entry.id}" collides with an editorial route slug of market "${market}".`,
      );
    }
    return {
      params: { market, slug },
      props: { entry, market },
    };
  });
}

const { entry, market } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  market={market}
  title={entry.data.title}
  description={entry.data.description}
  date={entry.data.date}
  image={entry.data.image}
  robots={entry.data.robots}
  toc={entry.data.toc}
  headings={headings}
  hreflangKey={entry.data.hreflangKey}
>
  <Content />
</ArticleLayout>
