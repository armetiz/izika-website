---
import '../styles/global.css';
import { localizedPath } from '../i18n';
import { btnPrimaryCompact } from '../lib/cta';

// Single root 404.html — Cloudflare Pages serves it for every missing URL,
// whatever the market, so the page is bilingual and market-neutral (no
// Header/Footer chrome, which would require picking a market).
const frHome = localizedPath('home', 'fr');
const enHome = localizedPath('home', 'uk');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page introuvable · Page not found — izika</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
  </head>
  <body class="flex min-h-dvh flex-col items-center justify-center bg-beige px-4 text-center">
    <a href={frHome} aria-label="izika">
      <img
        src="/assets/img/logo/izika-logo.png"
        alt="Logo izika"
        width="159"
        height="56"
        class="h-12 w-auto"
      />
    </a>

    <p class="mt-10 text-6xl font-bold text-primary" aria-hidden="true">404</p>

    <div class="mt-6 space-y-1" lang="fr">
      <h1 class="text-2xl font-bold">Page introuvable</h1>
      <p class="text-muted">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    </div>
    <div class="mt-4 space-y-1" lang="en">
      <p class="text-2xl font-bold">Page not found</p>
      <p class="text-muted">The page you are looking for doesn't exist or has been moved.</p>
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        class={btnPrimaryCompact}
        href={frHome}
        hreflang="fr-FR"
        lang="fr"
      >
        Accueil izika.com
      </a>
      <a
        class="btn-3d inline-block rounded-card border border-primary px-4 py-3 font-bold text-primary"
        href={enHome}
        hreflang="en-GB"
        lang="en"
      >
        izika.com in English
      </a>
    </div>
  </body>
</html>
